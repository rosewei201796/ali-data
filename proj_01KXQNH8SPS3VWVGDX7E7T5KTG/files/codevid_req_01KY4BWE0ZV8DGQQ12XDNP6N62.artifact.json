city: 0, y: 12 },\n    { opacity: 1, y: 0, duration: 0.4, ease: \"power2.out\" }, 0.3);\n\n  // Big background number - slow breathing pulse, finite repeats\n  tl.to(\"#big-number\",\n    { opacity: 0.32, duration: 1.2, ease: \"sine.inOut\", repeat: 7, yoyo: true }, 0);\n\n  var rows = [\n    { id: \"1991\", start: 1.0, width: 248 },\n    { id: \"1995\", start: 1.9, width: 348 },\n    { id: \"2000\", start: 2.8, width: 520 },\n    { id: \"2005\", start: 3.7, width: 700 },\n    { id: \"2010\", start: 4.6, width: 776 },\n    { id: \"2015\", start: 5.5, width: 792 },\n    { id: \"2020\", start: 6.4, width: 800 }\n  ];\n\n  rows.forEach(function (row, i) {\n    var isLast = i === rows.length - 1;\n\n    // row slides in\n    tl.fromTo(\"#row-\" + row.id,\n      { opacity: 0, x: -32 },\n      { opacity: 1, x: 0, duration: 0.4, ease: \"power2.out\" }, row.start);\n\n    // bar grows to target width\n    tl.fromTo(\"#bar-\" + row.id,\n      { width: \"0px\" },\n      { width: row.width + \"px\", duration: 0.6, ease: isLast ? \"back.out(1.6)\" : \"power2.out\" },\n      row.start + 0.4);\n\n    // value label fades in after bar completes\n    tl.fromTo(\"#value-\" + row.id,\n      { opacity: 0 },\n      { opacity: 1, duration: 0.2, ease: \"power1.out\" },\n      row.start + 1.0);\n  });\n\n  // Danger threshold line flashes on as the 2000 bar crosses 100%\n  tl.fromTo(\"#danger-line\",\n    { opacity: 0 },\n    { opacity: 1, duration: 0.14, ease: \"power1.out\" }, 3.8);\n  tl.to(\"#danger-line\", { opacity: 0.35, duration: 0.1, ease: \"power1.inOut\" }, 3.95);\n  tl.to(\"#danger-line\", { opacity: 1, duration: 0.12, ease: \"power1.inOut\" }, 4.07);\n\n  window.__timelines[\"japan-debt-gdp\"] = tl;\n</script>\n</body>\n</html>"
