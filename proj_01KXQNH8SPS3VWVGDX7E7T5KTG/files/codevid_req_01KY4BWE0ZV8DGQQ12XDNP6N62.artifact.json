    "index.html": "<!doctype html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<title>Japan Debt GDP Chart</title>\n<style>\n  html, body { margin:0; padding:0; background:#0a0a0a; }\n\n  #japan-debt-gdp {\n    position: relative;\n    width: 1280px;\n    height: 720px;\n    background: #0a0a0a;\n    overflow: hidden;\n    font-family: Impact, \"Arial Black\", sans-serif;\n  }\n\n  /* ---------- background texture ---------- */\n  .bg-rays {\n    position: absolute;\n    inset: 0;\n    background: repeating-conic-gradient(from 0deg, rgba(212,168,83,0.04) 0deg 2deg, transparent 2deg 20deg);\n    z-index: 0;\n  }\n\n  .gear {\n    position: absolute;\n    border-radius: 50%;\n    border: 3px solid rgba(255,255,255,0.15);\n    z-index: 1;\n  }\n  .gear-outer-tl { width:240px; height:240px; top:-90px; left:-90px; }\n  .gear-inner-tl { width:150px; height:150px; top:-45px; left:-45px; }\n  .gear-outer-br { width:240px; height:240px; bottom:-90px; right:-90px; }\n  .gear-inner-br { width:150px; height:150px; bottom:-45px; right:-45px; }\n\n  #big-number {\n    position: absolute;\n    right: 30px;\n    bottom: 10px;\n    font-size: 120px;\n    font-weight: 900;\n    color: #CC0000;\n    opacity: 0.15;\n    line-height: 1;\n    letter-spacing: -0.02em;\n    z-index: 1;\n  }\n\n  /* ---------- title block ---------- */\n  #title-main {\n    position: absolute;\n    top: 28px;\n    left: 0;\n    width: 100%;\n    text-align: center;\n    font-size: 76px;\n    font-weight: 900;\n    color: #FFFFFF;\n    text-shadow: 3px 3px 0 #CC0000;\n    letter-spacing: -0.03em;\n    z-index: 5;\n    opacity: 0;\n  }\n\n  #subtitle-main {\n    position: absolute;\n    top: 122px;\n    left: 0;\n    width: 100%;\n    text-align: center;\n    font-size: 26px;\n    font-style: italic;\n    font-weight: 700;\n    color: #9a9a9a;\n    letter-spacing: 0.01em;\n    z-index: 5;\n    opacity: 0;\n  }\n\n  /* ---------- chart ---------- */\n  #chart-area {\n    position: absolute;\n    left: 80px;\n    top: 160px;\n    width: 1100px;\n    height: 480px;\n    display: flex;\n    flex-direction: column;\n    gap: 20px;\n    z-index: 3;\n  }\n\n  .row {\n    display: flex;\n    align-items: center;\n    height: 40px;\n    gap: 16px;\n    opacity: 0;\n  }\n\n  .year-label {\n    flex: 0 0 110px;\n    text-align: right;\n    color: #888888;\n    font-weight: 900;\n    font-size: 28px;\n    font-variant-numeric: tabular-nums;\n    padding-right: 4px;\n  }\n\n  .bar-track {\n    flex: 1 1 auto;\n    height: 40px;\n    display: flex;\n    align-items: center;\n    min-width: 0;\n  }\n\n  .bar-fill {\n    height: 40px;\n    width: 0px;\n    background: #CC0000;\n    border: 3px solid #FFFFFF;\n    box-sizing: border-box;\n    flex: 0 0 auto;\n  }\n\n  .value-label {\n    margin-left: 10px;\n    color: #FFFFFF;\n    font-weight: 900;\n    font-size: 28px;\n    font-variant-numeric: tabular-nums;\n    white-space: nowrap;\n    opacity: 0;\n  }\n\n  #danger-line {\n    position: absolute;\n    left: 526px;\n    top: -24px;\n    width: 0;\n    height: 520px;\n    border-left: 4px dashed #CC0000;\n    opacity: 0;\n    z-index: 4;\n  }\n  #danger-line span {\n    position: absolute;\n    top: -32px;\n    left: 10px;\n    color: #CC0000;\n    font-weight: 900;\n    font-size: 20px;\n    letter-spacing: 0.02em;\n    white-space: nowrap;\n  }\n</style>\n</head>\n<body>\n\n<div id=\"japan-debt-gdp\"\n     data-composition-id=\"japan-debt-gdp\"\n     data-start=\"0\"\n     data-width=\"1280\"\n     data-height=\"720\"\n     data-duration=\"10\"\n     data-track-index=\"0\">\n\n  <div class=\"bg-rays\"></div>\n  <div class=\"gear gear-outer-tl\"></div>\n  <div class=\"gear gear-inner-tl\"></div>\n  <div class=\"gear gear-outer-br\"></div>\n  <div class=\"gear gear-inner-br\"></div>\n\n  <div id=\"big-number\">200%</div>\n\n  <div id=\"title-main\"\n       class=\"clip\"\n       data-start=\"0\"\n       data-duration=\"10\"\n       data-track-index=\"1\">JAPAN DEBT / GDP</div>\n\n  <div id=\"subtitle-main\"\n       class=\"clip\"\n       data-start=\"0.3\"\n       data-duration=\"9.7\"\n       data-track-index=\"2\">% of GDP &mdash; 30 years of stimulus</div>\n\n  <div id=\"chart-area\">\n\n    <div id=\"row-1991\" class=\"clip row\" data-start=\"1.0\" data-duration=\"9.0\" data-track-index=\"3\">\n      <span class=\"year-label\">1991</span>\n      <div class=\"bar-track\">\n        <div id=\"bar-1991\" class=\"bar-fill\"></div>\n        <span id=\"value-1991\" class=\"value-label\">62%</span>\n      </div>\n    </div>\n\n    <div id=\"row-1995\" class=\"clip row\" data-start=\"1.9\" data-duration=\"8.1\" data-track-index=\"4\">\n      <span class=\"year-label\">1995</span>\n      <div class=\"bar-track\">\n        <div id=\"bar-1995\" class=\"bar-fill\"></div>\n        <span id=\"value-1995\" class=\"value-label\">87%</span>\n      </div>\n    </div>\n\n    <div id=\"row-2000\" class=\"clip row\" data-start=\"2.8\" data-duration=\"7.2\" data-track-index=\"5\">\n      <span class=\"year-label\">2000</span>\n      <div class=\"bar-track\">\n        <div id=\"bar-2000\" class=\"bar-fill\"></div>\n        <span id=\"value-2000\" class=\"value-label\">130%</span>\n      </div>\n    </div>\n\n    <div id=\"row-2005\" class=\"clip row\" data-start=\"3.7\" data-duration=\"6.3\" data-track-index=\"6\">\n      <span class=\"year-label\">2005</span>\n      <div class=\"bar-track\">\n        <div id=\"bar-2005\" class=\"bar-fill\"></div>\n        <span id=\"value-2005\" class=\"value-label\">175%</span>\n      </div>\n    </div>\n\n    <div id=\"row-2010\" class=\"clip row\" data-start=\"4.6\" data-duration=\"5.4\" data-track-index=\"7\">\n      <span class=\"year-label\">2010</span>\n      <div class=\"bar-track\">\n        <div id=\"bar-2010\" class=\"bar-fill\"></div>\n        <span id=\"value-2010\" class=\"value-label\">194%</span>\n      </div>\n    </div>\n\n    <div id=\"row-2015\" class=\"clip row\" data-start=\"5.5\" data-duration=\"4.5\" data-