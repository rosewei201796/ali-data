    "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <link rel=\"stylesheet\" href=\"./vendor/fonts/catalog.css\">\n  <script src=\"vendor/gsap.min.js\"></script>\n  <style>\n    html, body {\n      margin: 0;\n      padding: 0;\n      width: 100%;\n      height: 100%;\n      background: #000;\n      overflow: hidden;\n    }\n    #comp {\n      position: relative;\n      width: 1280px;\n      height: 720px;\n      overflow: hidden;\n      background: #000;\n    }\n    #mainVideo {\n      position: absolute;\n      top: 0;\n      left: 0;\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      z-index: 0;\n    }\n    #auxVideo1,\n    #auxVideo2 {\n      position: absolute;\n      left: -9999px;\n      top: 0;\n      width: 1280px;\n      height: 720px;\n      visibility: hidden;\n      pointer-events: none;\n    }\n    #splitWrapper {\n      position: absolute;\n      top: 0;\n      left: 0;\n      width: 100%;\n      height: 100%;\n      z-index: 1;\n      pointer-events: none;\n      opacity: 0;\n      visibility: hidden;\n    }\n    #splitCanvas {\n      position: absolute;\n      top: 0;\n      left: 0;\n      width: 100%;\n      height: 100%;\n      z-index: 1;\n      pointer-events: none;\n    }\n    #barLeft,\n    #barRight {\n      position: absolute;\n      top: 0;\n      z-index: 2;\n      width: 10px;\n      height: 100%;\n      background: #000;\n      box-shadow: 0 0 10px rgba(0, 0, 0, 0.45);\n    }\n    #barLeft {\n      left: calc(33.33% - 5px);\n    }\n    #barRight {\n      left: calc(66.67% - 5px);\n    }\n  </style>\n</head>\n<body>\n  <div id=\"comp\"\n       data-composition-id=\"time-echo-split\"\n       data-start=\"0\"\n       data-width=\"1280\"\n       data-height=\"720\"\n       data-duration=\"30\">\n    <video id=\"mainVideo\"\n           class=\"clip\"\n           src=\"assets/backgroundVideo.mp4\"\n           data-start=\"0\"\n           data-duration=\"30\"\n           data-track-index=\"0\"\n           data-has-audio=\"true\"\n           playsinline></video>\n    <video id=\"auxVideo1\"\n           src=\"assets/backgroundVideo.mp4\"\n           data-start=\"0\"\n           data-duration=\"30\"\n           data-track-index=\"1\"\n           data-media-start=\"0.3\"\n           muted\n           playsinline></video>\n    <video id=\"auxVideo2\"\n           src=\"assets/backgroundVideo.mp4\"\n           data-start=\"0\"\n           data-duration=\"30\"\n           data-track-index=\"2\"\n           data-media-start=\"0.6\"\n           muted\n           playsinline></video>\n    <div id=\"splitWrapper\">\n      <canvas id=\"splitCanvas\" width=\"1280\" height=\"720\"></canvas>\n      <div id=\"barLeft\"></div>\n      <div id=\"barRight\"></div>\n    </div>\n  </div>\n  <script>\n    (function () {\n      var compId = \"time-echo-split\";\n      var mainVideo = document.getElementById(\"mainVideo\");\n      var auxVideo1 = document.getElementById(\"auxVideo1\");\n      var auxVideo2 = document.getElementById(\"auxVideo2\");\n      var splitWrapper = document.getElementById(\"splitWrapper\");\n      var splitCanvas = document.getElementById(\"splitCanvas\");\n      var barLeft = document.getElementById(\"barLeft\");\n      var barRight = document.getElementById(\"barRight\");\n      var ctx = splitCanvas.getContext(\"2d\");\n      var W = splitCanvas.width;\n      var H = splitCanvas.height;\n      var col = W / 3;\n\n      function drawSplit() {\n        if (!mainVideo || mainVideo.readyState < 2) return;\n        ctx.clearRect(0, 0, W, H);\n        try {\n          ctx.drawImage(mainVideo, 0, 0, col, H, 0, 0, col, H);\n        } catch (e) {}\n        if (auxVideo1 && auxVideo1.readyState >= 2) {\n          try {\n            ctx.drawImage(auxVideo1, col, 0, col, H, col, 0, col, H);\n          } catch (e2) {}\n        } else {\n          try {\n            ctx.drawImage(mainVideo, col, 0, col, H, col, 0, col, H);\n          } catch (e3) {}\n        }\n        if (auxVideo2 && auxVideo2.readyState >= 2) {\n          try {\n            ctx.drawImage(auxVideo2, col * 2, 0, col, H, col * 2, 0, col, H);\n          } catch (e4) {}\n        } else {\n          try {\n            ctx.drawImage(mainVideo, col * 2, 0, col, H, col * 2, 0, col, H);\n          } catch (e5) {}\n        }\n      }\n\n      window.__timelines = window.__timelines || {};\n      var tl = gsap.timeline({ paused: true });\n\n      gsap.set(splitWrapper, { autoAlpha: 0 });\n      gsap.set(barLeft, { xPercent: -100 });\n      gsap.set(barRight, { xPercent: 100 });\n      gsap.set(mainVideo, { opacity: 1 });\n\n      var triggers = [3.0, 12.0, 22.0];\n      var enterDur = 0.15;\n      var holdDur = 4.0;\n      var exitDur = 0.15;\n      var totalDur = enterDur + holdDur + exitDur;\n\n      for (var i = 0; i < triggers.length; i++) {\n        var t = triggers[i];\n        var exitAt = t + enterDur + holdDur;\n        var endAt = exitAt + exitDur;\n\n        tl.set(splitWrapper, { autoAlpha: 0 }, Math.max(0, t - 0.001));\n        tl.set(barLeft, { xPercent: -100 }, Math.max(0, t - 0.001));\n        tl.set(barRight, { xPercent: 100 }, Math.max(0, t - 0.001));\n        tl.set(mainVideo, { opacity: 1 }, Math.max(0, t - 0.001));\n\n        tl.fromTo(\n          splitWrapper,\n          { autoAlpha: 0 },\n          { autoAlpha: 1, duration: enterDur, ease: \"power2.out\", immediateRender: false, overwrite: \"auto\" },\n          t\n        );\n        tl.fromTo(\n          barLeft,\n          { xPercent: -100 },\n          { xPercent: 0, duration: enterDur, ease: \"power2.out\", immediateRender: false, overwrite: \"auto\" },\n          t\n        );\n        tl.fromTo(\n          barRight,\n          { xPercent: 100 },\n          { xPercent: 0, duration: enterDur, ease: \"power2.out\", immediateRender: false, overwrite: \"auto\" },\n          t\n        );\n        tl.fromTo(\n          mainVideo,\n          { opacity: 1 },\n          { opacity: 0, duration: enterDur, ease: \"power2.out\", immediateRender: false, overwrite: \"auto\" },\n          t\n        );\n\n        tl.to(\n          { __frame: 0 },\n          {\n            __frame: 1,\n            duration: totalDur,\n            ease: \"none\",\n            immediateRender: false,\n            onStart: drawSplit,\n            onUpdate: drawSplit\n          },\n          t\n        );\n\n        tl.to(\n          splitWrapper,\n          { autoAlpha: 0, duration: exitDur, ease: \"power2.in\", overwrite: \"auto\" },\n          exitAt\n        );\n        tl.to(\n          barLeft,\n          { xPercent: -100, duration: exitDur, ease: \"power2.in\", overwrite: \"auto\" },\n          exitAt\n        );\n        tl.to(\n          barRight,\n          { xPercent: 100, duration: exitDur, ease: \"power2.in\", overwrite: \"auto\" },\n          exitAt\n        );\n        tl.to(\n          mainVideo,\n          { opacity: 1, duration: exitDur, ease: \"power2.in\", overwrite: \"auto\" },\n          exitAt\n        );\n\n        tl.set(splitWrapper, { autoAlpha: 0 }, endAt);\n        tl.set(barLeft, { xPercent: -100 }, endAt);\n        tl.set(barRight, { xPercent: 100 }, endAt);\n        tl.set(mainVideo, { opacity: 1 }, endAt);\n      }\n\n      window.__timelines[compId] = tl;\n    })();\n  </script>\n</body>\n</html>"
