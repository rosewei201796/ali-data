terDur, ease: \"power2.out\", immediateRender: false, overwrite: \"auto\" },\n        t\n      );\n      tl.fromTo(\n        \"#bgVideo\",\n        { opacity: 1 },\n        { opacity: 0, duration: enterDur, ease: \"power2.out\", immediateRender: false, overwrite: \"auto\" },\n        t\n      );\n      tl.fromTo(\n        \"#barL\",\n        { xPercent: -100 },\n        { xPercent: 0, duration: enterDur, ease: \"power2.out\", immediateRender: false, overwrite: \"auto\" },\n        t\n      );\n      tl.fromTo(\n        \"#barR\",\n        { xPercent: 100 },\n        { xPercent: 0, duration: enterDur, ease: \"power2.out\", immediateRender: false, overwrite: \"auto\" },\n        t\n      );\n\n      tl.to(\n        \"#splitLayer\",\n        { opacity: 0, duration: exitDur, ease: \"power2.in\", overwrite: \"auto\" },\n        exitT\n      );\n      tl.to(\n        \"#bgVideo\",\n        { opacity: 1, duration: exitDur, ease: \"power2.in\", overwrite: \"auto\" },\n        exitT\n      );\n      tl.to(\n        \"#barL\",\n        { xPercent: -100, duration: exitDur, ease: \"power2.in\", overwrite: \"auto\" },\n        exitT\n      );\n      tl.to(\n        \"#barR\",\n        { xPercent: 100, duration: exitDur, ease: \"power2.in\", overwrite: \"auto\" },\n        exitT\n      );\n\n      tl.set(\"#splitLayer\", { opacity: 0 }, endT);\n      tl.set(\"#bgVideo\", { opacity: 1 }, endT);\n      tl.set(\"#barL\", { xPercent: -100 }, endT);\n      tl.set(\"#barR\", { xPercent: 100 }, endT);\n    }\n\n    window.__timelines[\"time-echo-split\"] = tl;\n  </script>\n</body>\n</html>"
