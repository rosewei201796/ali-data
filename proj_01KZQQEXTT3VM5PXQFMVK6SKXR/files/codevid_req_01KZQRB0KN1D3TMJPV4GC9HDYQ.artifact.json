    "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Eiffel Tower Plaza HUD</title>\n  <link rel=\"stylesheet\" href=\"./vendor/fonts/catalog.css\">\n  <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&display=swap\">\n  <script src=\"vendor/gsap.min.js\"></script>\n  <style>\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    html, body {\n      width: 100%;\n      height: 100%;\n      overflow: hidden;\n      background: #000;\n    }\n    #root {\n      position: relative;\n      width: 1280px;\n      height: 720px;\n      overflow: hidden;\n      background: #1a1410;\n    }\n    #bg-video {\n      position: absolute;\n      inset: 0;\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      z-index: 0;\n    }\n    .hud-layer {\n      position: absolute;\n      inset: 0;\n      z-index: 10;\n      pointer-events: none;\n    }\n\n    /* Top-left health / status */\n    .health-panel {\n      position: absolute;\n      top: 28px;\n      left: 28px;\n      display: flex;\n      flex-direction: column;\n      align-items: flex-start;\n      gap: 8px;\n      padding: 12px 16px 14px;\n      background: rgba(245, 230, 200, 0.72);\n      border: 3px solid #c4a06a;\n      border-radius: 16px;\n      box-shadow: 0 2px 0 #8b6914, inset 0 1px 0 rgba(255,255,255,0.45);\n    }\n    .hearts-row {\n      display: flex;\n      flex-direction: row;\n      gap: 8px;\n      align-items: center;\n    }\n    .heart {\n      width: 28px;\n      height: 26px;\n      display: block;\n    }\n    .stamina-wrap {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      margin-left: 2px;\n    }\n    .stamina-ring {\n      width: 22px;\n      height: 22px;\n      border-radius: 50%;\n      background:\n        conic-gradient(#e8a838 0deg 250deg, rgba(120, 90, 50, 0.28) 250deg