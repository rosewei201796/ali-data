"\n         data-track-index=\"3\">\n      <div class=\"dialogue-box\" id=\"dialogue-1-box\">\n        <div class=\"dialogue-label\">Adventurer</div>\n        <div class=\"dialogue-text\">You've got quite the view here! Mind if I join your quest log?</div>\n      </div>\n    </div>\n\n    <!-- Dialogue 2: 6.2–8.5 -->\n    <div id=\"dialogue-2\"\n         class=\"clip dialogue-wrap\"\n         data-start=\"6.2\"\n         data-duration=\"2.3\"\n         data-track-index=\"3\">\n      <div class=\"dialogue-box\" id=\"dialogue-2-box\">\n        <div class=\"dialogue-label\">Tourist</div>\n        <div class=\"dialogue-text\">Of course! Smile!</div>\n      </div>\n    </div>\n  </div>\n\n  <script>\n    window.__timelines = window.__timelines || {};\n    const tl = gsap.timeline({ paused: true });\n\n    // Scene name: fade in 0–0.3, hold, fade out 2.0–2.3\n    tl.fromTo(\"#scene-name\",\n      { opacity: 0 },\n      { opacity: 1, duration: 0.3, ease: \"power2.out\" },\n      0\n    );\n    tl.to(\"#scene-name\",\n      { opacity: 0, duration: 0.3, ease: \"power2.in\" },\n      2.0\n    );\n    tl.set(\"#scene-name\", { opacity: 0 }, 2.3);\n\n    // Dialogue 1: soft fade in/out within its clip window (timeline is global)\n    tl.fromTo(\"#dialogue-1-box\",\n      { opacity: 0, y: 12 },\n      { opacity: 1, y: 0, duration: 0.35, ease: \"power2.out\" },\n      2.5\n    );\n    tl.to(\"#dialogue-1-box\",\n      { opacity: 0, y: 8, duration: 0.3, ease: \"power2.in\" },\n      5.2\n    );\n    tl.set(\"#dialogue-1-box\", { opacity: 0 }, 5.5);\n\n    // Dialogue 2\n    tl.fromTo(\"#dialogue-2-box\",\n      { opacity: 0, y: 12 },\n      { opacity: 1, y: 0, duration: 0.35, ease: \"power2.out\" },\n      6.2\n    );\n    tl.to(\"#dialogue-2-box\",\n      { opacity: 0, y: 8, duration: 0.3, ease: \"power2.in\" },\n      8.2\n    );\n    tl.set(\"#dialogue-2-box\", { opacity: 0 }, 8.5);\n\n    // Subtle HUD life: finite potion glow pulse + tiny player-dot breath\n    const glowCycles = 6;\n    for (let i = 0; i < glowCycles; i++) {\n      const t = i * 1.6;\n      tl.fromTo(\"#slot-potion\",\n        { boxShadow: \"0 0 0 2px rgba(240,193,74,0.35), 0 0 10px rgba(240,193,74,0.4), inset 0 0 8px rgba(240,193,74,0.15)\" },\n        { boxShadow: \"0 0 0 2px rgba(240,193,74,0.55), 0 0 18px rgba(240,193,74,0.75), inset 0 0 12px rgba(240,193,74,0.28)\", duration: 0.8, ease: \"sine.inOut\", yoyo: true, repeat: 1 },\n        t\n      );\n    }\n\n    const dotCycles = 8;\n    for (let i = 0; i < dotCycles; i++) {\n      const t = i * 1.2;\n      tl.fromTo(\"#player-dot\",\n        { scale: 1 },\n        { scale: 1.18, duration: 0.6, ease: \"sine.inOut\", yoyo: true, repeat: 1, transformOrigin: \"50% 50%\" },\n        t\n      );\n    }\n\n    window.__timelines[\"eiffel-plaza-hud\"] = tl;\n  </script>\n</body>\n</html>"
