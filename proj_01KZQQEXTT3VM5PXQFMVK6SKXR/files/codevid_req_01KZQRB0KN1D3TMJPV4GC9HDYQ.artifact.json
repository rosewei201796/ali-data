    letter-spacing: 0.04em;\n      text-shadow: 0 1px 2px rgba(0,0,0,0.7);\n    }\n    .compass span {\n      position: absolute;\n      line-height: 1;\n    }\n    .compass .n { top: 8px; left: 50%; margin-left: -4px; }\n    .compass .s { bottom: 8px; left: 50%; margin-left: -3px; }\n    .compass .e { right: 9px; top: 50%; margin-top: -6px; }\n    .compass .w { left: 8px; top: 50%; margin-top: -6px; }\n    .minimap-roads {\n      position: absolute;\n      inset: 0;\n      opacity: 0.35;\n    }\n\n    /* Bottom-center quick items */\n    .item-bar {\n      position: absolute;\n      left: 50%;\n      bottom: 26px;\n      margin-left: -118px;\n      display: flex;\n      flex-direction: row;\n      gap: 10px;\n      padding: 10px 12px;\n      background: rgba(40, 28, 16, 0.55);\n      border: 2px solid rgba(212, 180, 120, 0.65);\n      border-radius: 14px;\n      box-shadow: 0 2px 8px rgba(0,0,0,0.3), inset 0 1px 0 rgba(255,240,200,0.12);\n    }\n    .item-slot {\n      width: 48px;\n      height: 48px;\n      border-radius: 10px;\n      background: rgba(245, 230, 200, 0.18);\n      border: 2px solid rgba(196, 160, 106, 0.7);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      position: relative;\n    }\n    .item-slot.active {\n      border-color: #f0c14a;\n      box-shadow:\n        0 0 0 2px rgba(240, 193, 74, 0.35),\n        0 0 14px rgba(240, 193, 74, 0.55),\n        inset 0 0 10px rgba(240, 193, 74, 0.2);\n      background: rgba(255, 220, 120, 0.22);\n    }\n    .item-slot svg {\n      width: 28px;\n      height: 28px;\n      display: block;\n    }\n\n    /* Scene name bar */\n    .scene-name {\n      position: absolute;\n      left: 28px;\n      bottom: 150px;\n      z-index: 20;\n      padding: 12px 22px 14px;\n      background: rgba(22, 16, 12, 0.72);\n      border: 2px solid rgba(212, 180, 120, 0.55);\n      border-radius: 14px;\n      opacity: 0;\n      max-width: 420px;\n    }\n    .scene-title {\n      font-family: \