    "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Seine Riverside HUD</title>\n  <link rel=\"stylesheet\" href=\"./vendor/fonts/catalog.css\">\n  <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Fondamento&family=Lora:wght@500;600&display=swap\">\n  <script src=\"vendor/gsap.min.js\"></script>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    html, body {\n      width: 100%;\n      height: 100%;\n      overflow: hidden;\n      background: #000;\n    }\n    #root {\n      position: relative;\n      width: 1280px;\n      height: 720px;\n      overflow: hidden;\n      background: #1a1410;\n    }\n    .backplate {\n      position: absolute;\n      inset: 0;\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      z-index: 0;\n    }\n    .hud-layer {\n      position: absolute;\n      inset: 0;\n      z-index: 10;\n      pointer-events: none;\n    }\n\n    /* Top-left health / status */\n    .status-panel {\n      position: absolute;\n      top: 28px;\n      left: 28px;\n      display: flex;\n      align-items: center;\n      gap: 14px;\n      padding: 10px 16px 10px 12px;\n      background: linear-gradient(145deg, rgba(58, 42, 28, 0.72), rgba(36, 26, 18, 0.68));\n      border: 2.5px solid rgba(232, 196, 120, 0.78);\n      border-radius: 14px;\n      box-shadow:\n        0 0 0 1px rgba(90, 60, 30, 0.45),\n        0 6px 18px rgba(20, 12, 6, 0.35);\n    }\n    .hearts {\n      display: flex;\n      gap: 5px;\n      align-items: center;\n    }\n    .heart {\n      width: 22px;\n      height: 22px;\n      position: relative;\n    }\n    .heart svg { width: 100%; height: 100%; display: block; filter: drop-shadow(0 1px 1px rgba(80, 20, 20, 0.45)); }\n    .stamina-wrap {\n      position: relative;\n      width: 44px;\n      height: 44px;\n      flex-shrink: 0;\n    }\n    .stamina-ring {\n      width: 44px;\n      height: 44px;\n      transform: rotate(-90deg);\n    }\n    .stamina-ring circle {\n      fill: none;\n      stroke-width: 4.5;\n    }\n    .stamina-bg { stroke: rgba(80, 60, 40, 0.55); }\n    .stamina-fg {\n      stroke: #e8b84a;\n      stroke-linecap: round;\n      stroke-dasharray: 113.1;\n      stroke-dashoffset: 28;\n    }\n    .stamina-core {\n      position: absolute;\n      inset: 8px;\n      border-radius: 50%;\n      background: radial-gradient(circle at 40% 35%, #f0d090, #c48a28 70%, #8a5a18);\n      border: 1.5px solid rgba(255, 230, 170, 0.55);\n      box-shadow: inset 0 1px 3px rgba(255, 240, 200, 0.35);\n    }\n    .status-label {\n      font-family: \"Lora\", serif;\n      font-size: 15px;\n      font-weight: 600;\n      color: rgba(255, 236, 200, 0.92);\n      letter-spacing: 0.04em;\n      text-shadow: 0 1px 2px rgba(40, 24, 8, 0.7);\n      line-height: 1.15;\n    }\n    .status-sub {\n      font-family: \"Lora\", serif;\n      font-size: 12px;\n      color: rgba(220, 190, 140, 0.75);\n      letter-spacing: 0.06em;\n      margin-top: 2px;\n    }\n\n    /* Bottom-right mini-map */\n    .minimap-cluster {\n      position: absolute;\n      right: 30px;\n      bottom: 118px;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      gap: 6px;\n    }\n    .sun-icon {\n      width: 28px;\n      height: 28px;\n      filter: drop-shadow(0 1px 3px rgba(180, 120, 40, 0.55));\n    }\n    .minimap {\n      position: relative;\n      width: 118px;\n      height: 118px;\n      border-radius: 50%;\n      background:\n        radial-gradient(circle at 45% 42%, rgba(236, 214, 168, 0.55), rgba(180, 148, 96, 0.42) 55%, rgba(120, 90, 50, 0.5));\n      border: 3px solid rgba(214, 176, 104, 0.88);\n      box-shadow:\n        0 0 0 2px rgba(70, 48, 24, 0.55),\n        inset 0 0 18px rgba(90, 60, 30, 0.25),\n        0 8px 20px rgba(20, 12, 6, 0.35);\n      overflow: hidden;\n    }\n    .minimap-inner {\n      position: absolute;\n      inset: 10px;\n      border-radius: 50%;\n      background:\n        linear-gradient(160deg, rgba(150, 175, 120, 0.35), rgba(110, 140, 150, 0.28)),\n        repeating-linear-gradient(0deg, transparent, transparent 11px, rgba(90, 70, 40, 0.08) 11px, rgba(90, 70, 40, 0.08) 12px),\n        repeating-linear-gradient(90deg, transparent, transparent 11px, rgba(90, 70, 40, 0.08) 11px, rgba(90, 70, 40, 0.08) 12px);\n      border: 1.5px solid rgba(180, 140, 80, 0.35);\n    }\n    .map-water {\n      position: absolute;\n      left: 8%;\n      top: 38%;\n      width: 84%;\n      height: 28%;\n      border-radius: 40% 50% 45% 55%;\n      background: rgba(90, 150, 180, 0.38);\n      transform: rotate(-8deg);\n    }\n    .player-dot {\n      position: absolute;\n      left: 52%;\n      top: 58%;\n      width: 10px;\n      height: 10px;\n      margin: -5px 0 0 -5px;\n      border-radius: 50%;\n      background: radial-gradient(circle at 35% 30%, #fff6d0, #e8a820 60%, #b06010);\n      border: 1.5px solid rgba(255, 245, 210, 0.9);\n      box-shadow: 0 0 8px rgba(255, 190, 60, 0.75);\n      z-index: 2;\n    }\n    .compass {\n      position: absolute;\n      inset: 0;\n      pointer-events: none;\n    }\n    .compass span {\n      position: absolute;\n      font-family: \"Fondamento\", \"Alfa Slab One\", serif;\n      font-size: 11px;\n      color: rgba(90, 58, 28, 0.85);\n      font-weight: 700;\n      text-shadow: 0 0 3px rgba(255, 240, 200, 0.5);\n    }\n    .compass .n { top: 6px; left: 50%; transform: translateX(-50%); }\n    .compass .e { right: 8px; top: 50%; transform: translateY(-50%); }\n    .compass .s { bottom: 6px; left: 50%; transform: translateX(-50%); }\n    .compass .w { left: 7px; top: 50%; transform: translateY(-50%); }\n\n    /* Quick-item bar bottom-center */\n    .item-bar {\n      position: absolute;\n      left: 50%;\n      bottom: 108px;\n      transform: translateX(-50%);\n      display: flex;\n      gap: 10px;\n      padding: 8px 12px;\n      background: linear-gradient(180deg, rgba(48, 34, 22, 0.55), rgba(28, 20, 14, 0.62));\n      border: 2px solid rgba(210, 172, 100, 0.55);\n      border-radius: 14px;\n      box-shadow: 0 4px 14px rgba(20, 12, 6, 0.3);\n    }\n    .item-slot {\n      width: 46px;\n      height: 46px;\n      border-radius: 10px;\n      background: linear-gradient(160deg, rgba(70, 50, 32, 0.75), rgba(40, 28, 18, 0.8));\n      border: 2px solid rgba(180, 140, 80, 0.55);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      position: relative;\n      box-shadow: inset 0 1px 4px rgba(0, 0, 0, 0.25);\n    }\n    .item-slot.active {\n      border-color: rgba(255, 210, 110, 0.95);\n      box-shadow:\n        inset 0 1px 4px rgba(0, 0, 0, 0.2),\n        0 0 12px rgba(255, 190, 70, 0.55),\n        0 0 0 1px rgba(255, 220, 140, 0.35);\n    }\n    .item-slot svg {\n      width: 26px;\n      height: 26px;\n      display: block;\n    }\n    .item-key {\n      position: absolute;\n      bottom: -2px;\n      right: -2px;\n      min-width: 14px;\n      height: 14px;\n      padding: 0 3px;\n      border-radius: 4px;\n      background: rgba(40, 28, 16, 0.9);\n      border: 1px solid rgba(200, 160, 90, 0.6);\n      font-family: \"Lora\", serif;\n      font-size: 10px;\n      line-height: 12px;\n      color: rgba(255, 230, 180, 0.9);\n      text-align: center;\n    }\n\n    /* Scene name bar */\n    .scene-name-clip {\n      position: absolute;\n      inset: 0;\n      z-index: 20;\n      pointer-events: none;\n    }\n    .scene-name-bar {\n      position: absolute;\n      left: 36px;\n      bottom: 200px;\n      max-width: 420px;\n      padding: 14px 22px 16px;\n      background: linear-gradient(135deg, rgba(22, 16, 12, 0.78), rgba(36, 26, 18, 0.72));\n      border: 2px solid rgba(210, 170, 100, 0.55);\n      border-left: 4px solid rgba(232, 188, 96, 0.9);\n      border-radius: 6px 14px 14px 6px;\n      box-shadow: 0 8px 24px rgba(10, 6, 2, 0.4);\n      opacity: 0;\n    }\n    .scene-title {\n      font-family: \"Fondamento\", \"Alfa Slab One\", serif;\n      font-size: 36px;\n      line-height: 1.15;\n      color: #fff4dc;\n      letter-spacing: -0.02em;\n      text-shadow: 0 2px 6px rgba(0, 0, 0, 0.55);\n      overflow-wrap: normal;\n      word-break: normal;\n    }\n    .scene-sub {\n      margin-top: 6px;\n      font-family: \"Lora\", serif;\n      font-size: 16px;\n      font-weight: 500;\n      color: rgba(232, 196, 120, 0.92);\n      letter-spacing: 0.08em;\n      text-transform: uppercase;\n      overflow-wrap: normal;\n      word-break: normal;\n    }\n\n    /* Dialogue box */\n    .dialogue-clip {\n      position: absolute;\n      inset: 0;\n      z-index: 25;\n      pointer-events: none;\n    }\n    .dialogue-box {\n      position: absolute;\n      left: 50%;\n      top: 76%;\n      width: min(860px, 86%);\n      margin-left: calc(min(860px, 86%) / -2);\n      padding: 16px 28px 18px;\n      background: linear-gradient(180deg, rgba(18, 14, 12, 0.82), rgba(28, 20, 16, 0.78));\n      border: 2.5px solid rgba(200, 164, 100, 0.55);\n      border-radius: 16px;\n      box-shadow:\n        0 10px 28px rgba(8, 4, 2, 0.42),\n        inset 0 1px 0 rgba(255, 230, 180, 0.08);\n      opacity: 0;\n    }\n    .speaker-label {\n      font-family: \"Fondamento\", \"Alfa Slab One\", serif;\n      font-size: 18px;\n      color: #f0c878;\n      letter-spacing: 0.04em;\n      margin-bottom: 6px;\n      text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);\n      overflow-wrap: normal;\n      word-break: normal;\n    }\n    .dialogue-text {\n      font-family: \"Lora\", serif;\n      font-size: 26px;\n      font-weight: 500;\n      line-height: 1.35;\n      color: #fff8ec;\n      text-shadow: 0 1px 3px rgba(0, 0, 0, 0.55);\n      overflow-wrap: normal;\n      word-break: normal;\n      max-width: 100%;\n    }\n  </style>\n</head>\n<body>\n  <div id=\"root\"\n       data-composition-id=\"seine-riverside-hud\"\n       data-start=\"0\"\n       data-w