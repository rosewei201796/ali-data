=\"stamina-ring\" viewBox=\"0 0 44 44\">\n            <circle class=\"stamina-bg\" cx=\"22\" cy=\"22\" r=\"18\"></circle>\n            <circle class=\"stamina-fg\" cx=\"22\" cy=\"22\" r=\"18\"></circle>\n          </svg>\n          <div class=\"stamina-core\"></div>\n        </div>\n        <div>\n          <div class=\"status-label\">Adventurer</div>\n          <div class=\"status-sub\">Ready</div>\n        </div>\n      </div>\n\n      <div class=\"minimap-cluster\" id=\"minimap-cluster\">\n        <svg class=\"sun-icon\" viewBox=\"0 0 32 32\" aria-hidden=\"true\">\n          <circle cx=\"16\" cy=\"16\" r=\"7\" fill=\"#f0c040\" stroke=\"#c48820\" stroke-width=\"1.5\"/>\n          <g stroke=\"#e8b040\" stroke-width=\"2\" stroke-linecap=\"round\">\n            <line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"/>\n            <line x1=\"16\" y1=\"26\" x2=\"16\" y2=\"30\"/>\n            <line x1=\"2\" y1=\"16\" x2=\"6\" y2=\"16\"/>\n            <line x1=\"26\" y1=\"16\" x2=\"30\" y2=\"16\"/>\n            <line x1=\"6.2\" y1=\"6.2\" x2=\"9\" y2=\"9\"/>\n            <line x1=\"23\" y1=\"23\" x2=\"25.8\" y2=\"25.8\"/>\n            <line x1=\"25.8\" y1=\"6.2\" x2=\"23\" y2=\"9\"/>\n            <line x1=\"9\" y1=\"23\" x2=\"6.2\" y2=\"25.8\"/>\n          </g>\n        </svg>\n        <div class=\"minimap\">\n          <div class=\"minimap-inner\">\n            <div class=\"map-water\"></div>\n            <div class=\"player-dot\" id=\"player-dot\"></div>\n          </div>\n          <div class=\"compass\">\n            <span class=\"n\">N</span>\n            <span class=\"e\">E</span>\n            <span class=\"s\">S</span>\n            <span class=\"w\">W</span>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"item-bar\" id=\"item-bar\">\n        <div class=\"item-slot active\" id=\"slot-potion\">\n          <svg viewBox=\"0 0 32 32\" aria-hidden=\"true\">\n            <path d=\"M13 4h6v3l3 4v12c0 2.2-1.8 4-4 4h-4c-2.2 0-4-1.8-4-4V11l3-4V4z\" fill=\"#6ec8a0\" stroke=\"#2a6a48\" stroke-width=\"1.6\"/>\n            <path d=\"M11 16h10v7c0 1.7-1.3 3-3 3h-4c-1.7 0-3-1.3-3-3v-7z\" fill=\"#3aa878\" opacity=\"0.85\"/>\n            <rect x=\"12\" y=\"2\" width=\"8\" height=\"3\" rx=\"1\" fill=\"#d4b070\" stroke=\"#8a6830\" stroke-width=\"1\"/>\n          </svg>\n          <span class=\"item-key\">1</span>\n        </div>\n        <div class=\"item-slot\" id=\"slot-map\">\n          <svg viewBox=\"0 0 32 32\" aria-hidden=\"true\">\n            <path d=\"M5 7l7-2 8 2 7-2v20l-7 2-8-2-7 2V7z\" fill=\"#e8d2a0\" stroke=\"#8a6830\" stroke-width=\"1.5\"/>\n            <path d=\"M12 5v18M20 7v18\" stroke=\"#b09050\" stroke-width=\"1.2\" fill=\"none\"/>\n            <circle cx=\"16\" cy=\"15\" r=\"2.2\" fill=\"#d06040\"/>\n          </svg>\n          <span class=\"item-key\">2</span>\n        </div>\n        <div class=\"item-slot\" id=\"slot-brush\">\n          <svg viewBox=\"0 0 32 32\" aria-hidden=\"true\">\n            <path d=\"M18 4l10 10-3 3-10-10 3-3z\" fill=\"#c8a878\" stroke=\"#6a4a28\" stroke-width=\"1.3\"/>\n            <path d=\"M7 18c4 0 7 2 8 5-4 1-8-1-10-4 1-1 1.5-1 2-1z\" fill=\"#6a90c8\" stroke=\"#304870\" stroke-width=\"1.2\"/>\n            <path d=\"M15 14l3 3\" stroke=\"#8a6830\" stroke-width=\"1.5\"/>\n          </svg>\n          <span class=\"item-key\">3</span>\n        </div>\n        <div class=\"item-slot\" id=\"slot-coffee\">\n          <svg viewBox=\"0 0 32 32\" aria-hidden=\"true\">\n            <path d=\"M8 12h14v10c0 3-2.5 5-6 5h-2c-3.5 0-6-2-6-5V12z\" fill=\"#f0e4d0\" stroke=\"#7a5a30\" stroke-width=\"1.5\"/>\n            <path d=\"M22 14h3c2 0 3 1.5 3 3.5S27 21 25 21h-3\" fill=\"none\" stroke=\"#7a5a30\" stroke-width=\"1.5\"/>\n            <path d=\"M10 8c1-2 2-2 3 0M15 7c1-2 2-2 3 0M20 8c1-2 2-2 3 0\" fill=\"none\" stroke=\"#b0a090\" stroke-width=\"1.3\" stroke-linecap=\"round\"/>\n            <ellipse cx=\"15\" cy=\"14\" rx=\"5\" ry=\"1.5\" fill=\"#6a3a1a\" opacity=\"0.7\"/>\n          </svg>\n          <span class=\"item-key\">4</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- Scene name: 0 – 2.2s, track 2 -->\n    <div id=\"scene-name-clip\"\n         class=\"clip scene-name-clip\"\n         data-start=\"0\"\n         data-duration=\"2.2\"\n         data-track-index=\"2\">\n      <div class=\"scene-name-bar\" id=\"scene-name-bar\">\n        <div class=\"scene-title\">Seine Riverside</div>\n        <div class=\"scene-sub\">Discovery: New Location</div>\n      </div>\n    </div>\n\n    <!-- Dialogue: 2.5 – 7.25s, track 3 -->\n    <div id=\"dialogue-clip\"\n         class=\"clip dialogue-clip\"\n         data-start=\"2.5\"\n         data-duration=\"4.75\"\n         data-track-index=\"3\">\n      <div class=\"dialogue-box\" id=\"dialogue-box\">\n        <div class=\"speaker-label\">Adventurer</div>\n        <div class=\"dialogue-text\">This light… it's like the world itself is casting a golden-hour buff.</div>\n      </div>\n    </div>\n\n    <!-- SFX discovery chime: sync_point_to_time @ 0.05s, syncPointMs=75 -->\n    <audio id=\"sfx_discovery_chime_event_1\"\n           src=\"assets/sfx_location_discover_1.mp3\"\n           data-start=\"0\"\n           data-media-start=\"0.025\"\n           data-volume=\"0.18\"\n           data-track-index=\"4\"></audio>\n  </div>\n\n  <script>\n    window.__timelines = window.__timelines || {};\n    const tl = gsap.timeline({ paused: true });\n\n    // HUD entrance — soft settle\n    tl.fromTo(\"#status-panel\",\n      { opacity: 0, y: -16 },\n      { opacity: 1, y: 0, duration: 0.55, ease: \"power2.out\", overwrite: \"auto\" },\n      0.05);\n    tl.fromTo(\"#minimap-cluster\",\n      { opacity: 0, scale: 0.88 },\n      { opacity: 1, scale: 1, duration: 0.6, ease: \"power2.out\", overwrite: \"auto\" },\n      0.12);\n    tl.fromTo(\"#item-bar\",\n      { opacity: 0, y: 14 },\n      { opacity: 1, y: 0, duration: 0.5, ease: \"power2.out\", overwrite: \"auto\" },\n      0.18);\n\n    // Scene name bar: fade in 0–0.4, hold, fade out 2.0–2.2\n    tl.fromTo(\"#scene-name-bar\",\n      { opacity: 0, y: 18 },\n      { opacity: 1, y: 0, duration: 0.4, ease: \"power2.out\", overwrite: \"auto\" },\n      0);\n    tl.to(\"#scene-name-bar\",\n      { opacity: 0, y: -8, duration: 0.2, ease: \"power1.in\", overwrite: \"auto\" },\n      2.0);\n    tl.set(\"#scene-name-bar\", { opacity: 0 }, 2.2);\n\n    // Dialogue: soft fade/slide 2.5–2.85, hold, out 7.0–7.25\n    tl.fromTo(\"#dialogue-box\",\n      { opacity: 0, y: 20 },\n      { opacity: 1, y: 0, duration: 0.35, ease: \"power2.out\", overwrite: \"auto\" },\n      2.5);\n    tl.to(\"#dialogue-box\",\n      { opacity: 0, y: 10, duration: 0.25, ease: \"power1.in\", overwrite: \"auto\" },\n      7.0);\n    tl.set(\"#dialogue-box\", { opacity: 0 }, 7.25);\n\n    // Ambient: active slot glow pulse (finite cycles over 10s)\n    const glowCycles = Math.floor(10 / 1.6) - 1;\n    tl.fromTo(\"#slot-potion\",\n      { boxShadow: \"inset 0 1px 4px rgba(0,0,0,0.2), 0 0 8px rgba(255,190,70,0.35), 0 0 0 1px rgba(255,220,140,0.25)\" },\n      {\n        boxShadow: \"inset 0 1px 4px rgba(0,0,0,0.2), 0 0 16px rgba(255,190,70,0.7), 0 0 0 1px rgba(255,220,140,0.5)\",\n        duration: 0.8,\n        ease: \"sine.inOut\",\n        yoyo: true,\n        repeat: glowCycles,\n        overwrite: \"auto\"\n      },\n      0.5);\n\n    // Subtle player-dot breath on minimap (opacity only — no transform stack)\n    const dotCycles = Math.floor(10 / 1.4) - 1;\n    tl.fromTo(\"#player-dot\",\n      { opacity: 0.75 },\n      {\n        opacity: 1,\n        duration: 0.7,\n        ease: \"sine.inOut\",\n        yoyo: true,\n        repeat: dotCycles,\n        overwrite: \"auto\"\n      },\n      0.4);\n\n    window.__timelines[\"seine-riverside-hud\"] = tl;\n  </script>\n</body>\n</html>"
