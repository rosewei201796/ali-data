    "index.html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;700&display=swap\">\n<style>\n*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}\n\nbody{width:1920px;height:1080px;overflow:hidden;background:#0d1117;}\n\n#root-comp{\n  position:relative;\n  width:1920px;\n  height:1080px;\n  overflow:hidden;\n  background:linear-gradient(160deg,#0d1117 0%,#131a2e 60%,#0a0f1e 100%);\n  display:flex;\n  align-items:center;\n  justify-content:center;\n}\n\n/* Background radial glow texture */\n#bg-glow{\n  position:absolute;\n  inset:0;\n  background:\n    radial-gradient(ellipse 900px 600px at 50% 45%, rgba(60,100,200,0.13) 0%, transparent 70%),\n    radial-gradient(ellipse 600px 400px at 20% 80%, rgba(30,60,140,0.10) 0%, transparent 60%),\n    radial-gradient(ellipse 500px 350px at 80% 20%, rgba(80,60,160,0.08) 0%, transparent 60%);\n  pointer-events:none;\n  z-index:1;\n}\n\n/* Ghost decorative lines */\n#bg-lines{\n  position:absolute;\n  inset:0;\n  z-index:1;\n  pointer-events:none;\n  overflow:hidden;\n}\n#bg-lines::before{\n  content:\"\";\n  position:absolute;\n  left:0;top:50%;\n  width:100%;height:1px;\n  background:linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.04) 30%, rgba(255,255,255,0.04) 70%, transparent 100%);\n}\n#bg-lines::after{\n  content:\"\";\n  position:absolute;\n  top:0;left:50%;\n  width:1px;height:100%;\n  background:linear-gradient(180deg, transparent 0%, rgba(255,255,255,0.04) 30%, rgba(255,255,255,0.04) 70%, transparent 100%);\n}\n\n/* Card stages — each card scene */\n.card-stage{\n  position:absolute;\n  display:flex;\n  flex-direction:column;\n  align-items:center;\n  z-index:10;\n  opacity:0;\n  top:50%;\n  left:50%;\n}\n\n/* Demo wrapper — perspective container, counter-rotation */\n.demo{\n  position:relative;\n  width:340px;\n  height:480px;\n  perspective:1000px;\n  transform-style:preserve-3d;\n  flex-shrink:0;\n}\n\n.demo-inner{\n  position:relative;\n  width:100%;\n  height:100%;\n  transform-style:preserve-3d;\n  transform:rotateX(10deg) rotateZ(0deg);\n  background:#ffffff;\n  border-radius:6px;\n}\n\n.demo-inner::before{\n  content:\"\";\n  z-index:-1;\n  position:absolute;\n  left:0;top:0;\n  width:100%;height:100%;\n  box-shadow:0 50px 100px rgba(0,0,0,0.7), 0 20px 40px rgba(0,0,0,0.45);\n  border-radius:6px;\n}\n\n/* Image inside card */\n.demo-img{\n  overflow:hidden;\n  position:absolute;\n  left:18px;top:18px;\n  width:304px;height:416px;\n  transform:translateZ(8px) scale(0.97);\n  border-radius:3px;\n}\n\n.demo-img img{\n  width:100%;\n  height:100%;\n  object-fit:cover;\n  display:block;\n  filter:grayscale(10%) contrast(1.08) brightness(1.02);\n}\n\n/* Shiny sweep overlay on the image */\n.demo-img::after{\n  content:\"\";\n  z-index:2;\n  position:absolute;\n  left:-20%;top:0;\n  width:80%;\n  padding-bottom:80%;\n  border-radius:50%;\n  background:radial-gradient(ellipse farthest-corner at center, rgba(255,255,255,0.30) 0%, rgba(255,255,255,0) 100%);\n  pointer-events:none;\n  /* driven by GSAP, start off-screen top */\n  transform:translateY(-110%);\n}\n\n/* Role label below card */\n.role-label{\n  margin-top:36px;\n  text-align:center;\n  opacity:0;\n  transform:translateY(12px);\n}\n\n.role-label .type-line{\n  font-family:'DM Sans', sans-serif;\n  font-size:18px;\n  font-weight:700;\n  letter-spacing:0.28em;\n  text-transform:uppercase;\n  color:rgba(220,216,208,0.50);\n  margin-bottom:12px;\n}\n\n.role-label .name-line{\n  font-family:'DM Serif Display', Georgia, serif;\n  font-size:62px;\n  font-weight:400;\n  color:#f0ece4;\n  line-height:0.92;\n  letter-spacing:-0.02em;\n}\n\n.role-label .year-line{\n  font-family:'DM Sans', sans-serif;\n  font-size:20px;\n  font-weight:300;\n  letter-spacing:0.18em;\n  text-transform:uppercase;\n  color:rgba(220,216,208,0.38);\n  margin-top:14px;\n}\n\n/* Open / close fades */\n#open-fade,#close-fade{\n  position:absolute;\n  inset:0;\n  z-index:50;\n  background:#0d1117;\n  pointer-events:none;\n}\n#open-fade{opacity:1;}\n#close-fade{opacity:0;}\n</style>\n</head>\n<body>\n<div\n  id=\"root-comp\"\n  data-composition-id=\"role-card-showcase\"\n  data-start=\"0\"\n  data-width=\"1920\"\n  data-height=\"1080\"\n  data-duration=\"16\"\n  data-track-index=\"0\"\n>\n\n  <!-- Background texture -->\n  <div id=\"bg-glow\"></div>\n  <div id=\"bg-lines\"></div>\n\n  <!-- CARD 1: Alan Turing -->\n  <div class=\"card-stage\" id=\"s1\">\n    <div class=\"demo\" id=\"demo1-wrapper\">\n      <div class=\"demo-inner\" id=\"demo1-inner\">\n        <div class=\"demo-img\" id=\"demo1-img\">\n          <img src=\"assets/img1.jpg\" alt=\"\">\n        </div>\n      </div>\n    </div>\n    <div class=\"role-label\" id=\"l1\">\n      <div class=\"type-line\">Film · 2014</div>\n      <div class=\"name-line\">Alan Turing</div>\n      <div class=\"year-line\">The Imitation Game</div>\n    </div>\n  </div>\n\n  <!-- CARD 2: Sherlock Holmes -->\n  <div class=\"card-stage\" id=\"s2\">\n    <div class=\"demo\" id=\"demo2-wrapper\">\n      <div class=\"demo-inner\" id=\"demo2-inner\">\n        <div class=\"demo-img\" id=\"demo2-img\">\n          <img src=\"assets/img2.jpg\" alt=\"\">\n        </div>\n      </div>\n    </div>\n    <div class=\"role-label\" id=\"l2\">\n      <div class=\"type-line\">Television · 2010</div>\n      <div class=\"name-line\">Sherlock Holmes</div>\n      <div class=\"year-line\">BBC One</div>\n    </div>\n  </div>\n\n  <!-- CARD 3: Hamlet -->\n  <div class=\"card-stage\" id=\"s3\">\n    <div class=\"demo\" id=\"demo3-wrapper\">\n      <div class=\"demo-inner\" id=\"demo3-inner\">\n        <div class=\"demo-img\" id=\"demo3-img\">\n          <img src=\"assets/img3.jpg\" alt=\"\">\n        </div>\n      </div>\n    </div>\n    <div class=\"role-label\" id=\"l3\">\n      <div class=\"type-line\">Stage · 2015</div>\n      <div class=\"name-line\">Hamlet</div>\n      <div class=\"year-line\">Barbican Theatre, London</div>\n    </div>\n  </div>\n\n  <!-- Fades -->\n  <div id=\"open-fade\"></div>\n  <div id=\"close-fade\"></div>\n\n</div>\n\n<script src=\"vendor/gsap.min.js\"></script>\n<script>\n(function(){\n  window.__timelines = window.__timelines || {};\n\n  var tl = gsap.timeline({ paused: true });\n\n  // Helper: card-stage starts centered via top:50%, left:50%\n  // We set translate -50%,-50% via GSAP at start to avoid CSS transform conflicts\n  // All stages: set initial transform (center) once, hidden\n  gsap.set(['#s1','#s2','#s3'], { xPercent: -50, yPercent: -55, opacity: 0 });\n  gsap.set('#open-fade', { opacity: 1 });\n  gsap.set('#close-fade', { opacity: 0 });\n\n  // Initial card inner rotation state\n  gsap.set('#demo1-inner', { rotateX: 10, rotateZ: 0 });\n  gsap.set('#demo2-inner', { rotateX: 10, rotateZ: 0 });\n  gsap.set('#demo3-inner', { rotateX: 10, rotateZ: 0 });\n  gsap.set('#demo1-wrapper', { rotateZ: 0 });\n  gsap.set('#demo2-wrapper', { rotateZ: 0 });\n  gsap.set('#demo3-wrapper', { rotateZ: 0 });\n\n  // Shiny overlays start above card\n  gsap.set(['#demo1-img::after','#demo2-img::after','#demo3-img::after'], { y: '-110%' });\n\n  // ─── OPEN FADE ───────────────────────────────────────────────\n  tl.to('#open-fade', { opacity: 0, duration: 0.55, ease: 'power2.out' }, 0.0);\n\n  // ─── CARD 1 ──────────────────────────────────────────────────\n  // s1 appears at t=0.4\n  tl.to('#s1', { opacity: 1, scale: 1, duration: 0.65, ease: 'back.out(1.4)',\n    startAt: { scale: 0.82 } }, 0.35);\n\n  // 3D rotation — wrapper counter-rotates, inner co-rotates\n  // Card 1 visible window: 0.35 → ~5.1 (≈4.75s), one full turn = 3s → ~1.58 full turns\n  var c1dur = 4.6;\n  var c1turns = Math.floor(c1dur / 3); // 1 full turn finite\n  tl.to('#demo1-wrapper', { rotateZ: -360 * (c1turns + 1), duration: c1dur, ease: 'none' }, 0.35);\n  tl.to('#demo1-inner',   { rotateX: 10, rotateZ: 360 * (c1turns + 1), duration: c1dur, ease: 'none' }, 0.35);\n\n  // Shiny sweep on #demo1-img — drive translateY via GSAP on a proxy object\n  // We animate the ::after pseudo via a CSS variable trick using a wrapper div instead\n  // Since we can't animate ::after directly, we'll use a real div overlay inside .demo-img\n  // → handled via separate overlay divs (see HTML below — we'll use JS to add them)\n\n  // Label fade in\n  tl.to('#l1', { opacity: 1, y: 0, duration: 0.5, ease: 'power3.out' }, 0.75);\n\n  // Card 1 exit at t=4.7\n  tl.to('#l1', { opacity: 0, y: -10, duration: 0.35, ease: 'power2.in' }, 4.5);\n  tl.to('#s1', { opacity: 0, scale: 0.87, duration: 0.45, ease: 'power2.in' }, 4.55);\n  tl.set('#s1', { opacity: 0, scale: 1 }, 5.1);\n\n  // ─── CARD 2 ──────────────────────────────────────────────────\n  tl.to('#s2', { opacity: 1, scale: 1, duration: 0.65, ease: 'back.out(1.4)',\n    startAt: { scale: 0.82 } }, 5.0);\n\n  var c2dur = 4.6;\n  var c2turns = Math.floor(c2dur / 3);\n  tl.to('#demo2-wrapper', { rotateZ: -360 * (c2turns + 1), duration: c2dur, ease: 'none' }, 5.0);\n  tl.to('#demo2-inner',   { rotateX: 10, rotateZ: 360 * (c2turns + 1), duration: c2dur, ease: 'none' }, 5.0);\n\n  tl.to('#l2', { opacity: 1, y: 0, duration: 0.5, ease: 'power3.out' }, 5.4);\n\n  tl.to('#l2', { opacity: 0, y: -10, duration: 0.35, ease: 'power2.in' }, 9.5);\n  tl.to('#s2', { opacity: 0, scale: 0.87, duration: 0.45, ease: 'power2.in' }, 9.55);\n  tl.set('#s2', { opacity: 0, scale: 1 }, 10.1);\n\n  // ─── CARD 3 ──────────────────────────────────────────────────\n  tl.to('#s3', { opacity: 1, scale: 1, duration: 0.65, ease: 'back.out(1.4)',\n    startAt: { scale: 0.82 } }, 10.0);\n\n  var c3dur = 4.6;\n  var c3turns = Math.floor(c3dur / 3);\n  tl.to('#demo3-wrapper', { rotateZ: -360 * (c3turns + 1), duration: c3dur, ease: 'none' }, 10.0);\n  tl.to('#demo3-inner',   { rotateX: 10, rotateZ: 360 * (c3turns + 1), duration: c3dur, ease: 'none' }, 10.0);\n\n  tl.to('#l3', { opacity: 1, y: 0, duration: 0.5, ease: 'power3.out' }, 10.4);\n\n  tl.to('#l3', { opacity: 0, y: -10, duration: 0.35, ease: 'power2.in' }, 14.5);\n  tl.to('#s3', { opacity: 0, scale: 0.87, duration: 0.45, ease: 'power2.in' }, 14.55);\n\n  // ─── CLOSE FADE ──────────────────────────────────────────────\n  tl.to('#close-fade', { opacity: 1, duration: 0.7, ease: 'power2.inOut' }, 14.8);\n  tl.set('#close-fade', { opacity: 1 }, 15.6);\n\n  // ─── SHINY SWEEP — real div overlays ────────────────────────\n  // Inject overlay divs into each .demo-img, then animate them\n  var ids = ['demo1-img','demo2-img','demo3-img'];\n  var starts = [0.35, 5.0, 10.0];\n  var shinyOverlays = [];\n\n  ids.forEach(function(id, i){\n    var container = document.getElementById(id);\n    var overlay = document.createElement('div');\n    overlay.style.cssText = [\n      'position:absolute',\n      'left:-20%',\n      'top:0',\n      'width:80%',\n      'padding-bottom:80%',\n      'border-radius:50%',\n      'background:radial-gradient(ellipse farthest-corner at center, rgba(255,255,255,0.28) 0%, rgba(255,255,255,0) 100%)',\n      'z-index:2',\n      'pointer-events:none',\n      'transform:translateY(-110%)'\n    ].join(';');\n    overlay.id = 'shiny-' + (i+1);\n    container.appendChild(overlay);\n    shinyOverlays.push(overlay);\n\n    // Animate sweep: move from top (-110%) down through card (~520px = 110% of 480px container)\n    // then reset. Two sweeps across the visible window.\n    var sweepStart = starts[i] + 0.5;\n    var cycleDur = 1.6;\n    var visibleWindow = 4.0;\n    var numSweeps = Math.floor(visibleWindow / cycleDur); // 2\n\n    for(var s = 0; s < numSweeps; s++){\n      var t0 = sweepStart + s * (visibleWindow / numSweeps);\n      // sweep down\n      tl.fromTo('#shiny-' + (i+1),\n        { y: '-110%' },\n        { y: '520px', duration: cycleDur * 0.55, ease: 'power1.inOut' },\n        t0\n      );\n      // reset to top-right offset\n      tl.fromTo('#shiny-' + (i+1),\n        { x: '85%', y: '-110%' },\n        { x: '85%', y: '520px', duration: cycleDur * 0.45, ease: 'power1.inOut' },\n        t0 + cycleDur * 0.55 + 0.05\n      );\n    }\n  });\n\n  window.__timelines['role-card-showcase'] = tl;\n})();\n</script>\n</body>\n</html>"
