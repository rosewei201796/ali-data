10;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    align-items: flex-start;\n    padding: 0 140px;\n  }\n\n  /* Header label */\n  #header-label {\n    font: 700 18px/1 'Barlow Condensed', sans-serif;\n    letter-spacing: 0.22em;\n    text-transform: uppercase;\n    color: var(--red);\n    margin-bottom: 28px;\n    opacity: 0;\n  }\n\n  /* Headline */\n  #headline {\n    font: 400 88px/1.0 'Libre Baskerville', Georgia, serif;\n    color: var(--paper);\n    letter-spacing: -0.03em;\n    margin-bottom: 72px;\n    opacity: 0;\n  }\n\n  #headline em {\n    font-style: italic;\n    color: var(--gold);\n  }\n\n  /* Timeline axis container */\n  #axis-wrap {\n    position: relative;\n    width: 1640px;\n    height: 180px;\n  }\n\n  /* The base axis line */\n  #axis-base {\n    position: absolute;\n    top: 52px;\n    left: 0;\n    width: 100%;\n    height: 2px;\n    background: var(--line);\n  }\n\n  /* Progress line drawn over axis */\n  #axis-progress {\n    position: absolute;\n    top: 52px;\n    left: 0;\n    width: 100%;\n    height: 2px;\n    background: var(--red);\n    transform-origin: left center;\n    transform: scaleX(0);\n  }\n\n  /* Milestone columns */\n  .milestone {\n    position: absolute;\n    top: 0;\n    width: 400px;\n    opacity: 0;\n  }\n\n  #ms-a { left: 0; }\n  #ms-b { left: 620px; }\n  #ms-c { left: 1240px; }\n\n  /* Dot on axis */\n  .ms-dot {\n    position: absolute;\n    top: 43px;\n    left: 0;\n    width: 20px;\n    height: 20px;\n    border: 3px solid var(--red);\n    border-radius: 50%;\n    background: var(--bg);\n  }\n\n  #ms-b .ms-dot { left: 0; }\n  #ms-c .ms-dot { left: 0; }\n\n  /* Dot glow ring */\n  .ms-dot-ring {\n    position: absolute;\n    top: 35px;\n    left: -8px;\n    width: 36px;\n    height: 36px;\n    border: 1px solid rgba(201,50,46,0.35);\n    border-radius: 50%;\n    opacity: 0;\n  }\n\n  /* Year number */\n  .ms-year {\n    margin-top: 88px;\n    font: 400 64px/1 'Libre Baskerville', Georgia, serif;\n    color: var(--gold);\n    letter-spacing: -0.02em;\n    font-variant-numeric: tabular-nums;\n  }\n\n  /* Role/title */\n  .ms-title {\n    margin-top: 14px;\n    font: 700 26px/1.2 'Barlow Condensed', sans-serif;\n    letter-spacing: 0.10em;\n    text-transform: uppercase;\n    color: var(--paper);\n  }\n\n  /* Subtitle/proof */\n  .ms-sub {\n    margin-top: 8px;\n    font: 300 22px/1.4 'Barlow Condensed', sans-serif;\n    letter-spacing: 0.05em;\n    color: var(--muted);\n  }\n\n  /* Connector tick from dot upward */\n  .ms-tick {\n    position: absolute;\n    top: 20px;\n    left: 9px;\n    width: 2px;\n    height: 23px;\n    background: var(--red);\n    transform-origin: top center;\n    transform: scaleY(0);\n  }\n</style>\n</head>\n<body>\n<div id=\"comp-root\"\n     data-composition-id=\"career-ladder\"\n     data-start=\"0\"\n     data-width=\"1920\"\n     data-height=\"1080\"\n     data-duration=\"6\"\n     data-track-index=\"0\">\n\n  <!-- Background video -->\n  <video id=\"bg-vid\"\n         src=\"assets/bgVid.mp4\"\n         muted\n         playsinline\n         data-start=\"0\"\n         data-track-index=\"1\">\n  </video>\n\n  <!-- Overlays -->\n  <div id=\"vig\"></div>\n  <div id=\"top-fade\"></div>\n  <div id=\"ghost-letters\">CAREER</div>\n\n  <!-- Content -->\n  <div id=\"ladder-wrap\">\n    <div id=\"header-label\">Selected Filmography</div>\n    <div id=\"headline\">Three defining <em>roles</em></div>\n\n    <div id=\"axis-wrap\">\n      <div id=\"axis-base\"></div>\n      <div id=\"axis-progress\"></div>\n\n      <!-- Milestone A -->\n      <div class=\"milestone\" id=\"ms-a\">\n        <div class=\"ms-tick\"></div>\n        <div class=\"ms-dot\"></div>\n        <div class=\"ms-dot-ring\"></div>\n        <div class=\"ms-year\">2004</div>\n        <div class=\"ms-title\">Hawking</div>\n        <div class=\"ms-sub\">BBC Television Film</div>\n      </div>\n\n      <!-- Milestone B -->\n      <div class=\"milestone\" id=\"ms-b\">\n        <div class=\"ms-tick\"></div>\n        <div class=\"ms-dot\"></div>\n        <div class=\"ms-dot-ring\"></div>\n        <div class=\"ms-year\">2010</div>\n        <div class=\"ms-title\">Sherlock</div>\n        <div class=\"ms-sub\">BBC One · Global Breakthrough</div>\n      </div>\n\n      <!-- Milestone C -->\n      <div class=\"milestone\" id=\"ms-c\">\n        <div class=\"ms-tick\"></div>\n        <div class=\"ms-dot\"></div>\n        <div class=\"ms-dot-ring\"></div>\n        <div class=\"ms-year\">2016</div>\n        <div class=\"ms-title\">Doctor Strange</div>\n        <div class=\"ms-sub\">Marvel Studios · MCU</div>\n      </div>\n    </div>\n  </div>\n\n</div>\n\n<script src=\"vendor/gsap.min.js\"></script>\n<script>\n  window.__timelines = window.__timelines || {};\n\n  var tl = gsap.timeline({ paused: true });\n\n  // --- HEADER + HEADLINE slide up ---\n  tl.fromTo('#header-label',\n    { opacity: 0, y: 16 },\n    { opacity: 1, y: 0, duration: 0.5, ease: 'power3.out' },\n    0.2\n  );\n\n  tl.fromTo('#headline',\n    { opacity: 0, y: 24 },\n    { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out' },\n    0.45\n  );\n\n  // --- MILESTONE A appears ---\n  tl.fromTo('#ms-a',\n    { opacity: 0, y: 18 },\n    { opacity: 1, y: 0, duration: 0.5, ease: 'power3.out' },\n    0.85\n  );\n\n  // Tick reveals\n  tl.fromTo('#ms-a .ms-tick',\n    { scaleY: 0 },\n    { scaleY: 1, duration: 0.25, ease: 'power2.out' },\n    0.9\n  );\n\n  // Dot ring pulse for A\n  tl.fromTo('#ms-a .ms-dot-ring',\n    { opacity: 0.8, scale: 0.6 },\n    { opacity: 0, scale: 1.6, duration: 0.55, ease: 'power2.out' },\n    1.0\n  );\n\n  // Progress line draws to 50%\n  tl.fromTo('#axis-progress',\n    { scaleX: 0 },\n    { scaleX: 0.378, duration: 0.65, ease: 'expo.out' },\n    0.9\n  );\n\n  // --- MILESTONE B appears ---\n  tl.fromTo('#ms-b',\n    { opacity: 0, y: 18 },\n    { opacity: 1, y: 0, duration: 0.5, ease: 'power3.out' },\n    1.75\n  );\n\n  tl.fromTo('#ms-b .ms-tick',\n    { scaleY: 0 },\n    { scaleY: 1, duration: 0.25, ease: 'power2.out' },\n    1.8\n  );\n\n  tl.fromTo('#ms-b .ms-dot-ring',\n    { opacity: 0.8, scale: 0.6 },\n    { opacity: 0, scale: 1.6, duration: 0.55, ease: 'power2.out' },\n    1.9\n  );\n\n  // Progress line draws to ~75%\n  tl.to('#axis-progress',\n    { scaleX: 0.757, duration: 0.65, ease: 'expo.out' },\n    1.8\n  );\n\n  // --- MILESTONE C appears ---\n  tl.fromTo('#ms-c',\n    { opacity: 0, y: 18 },\n    { opacity: 1, y: 0, duration: 0.5, ease: 'power3.out' },\n    2.65\n  );\n\n  tl.fromTo('#ms-c .ms-tick',\n    { scaleY: 0 },\n    { scaleY: 1, duration: 0.25, ease: 'power2.out' },\n    2.7\n  );\n\n  tl.fromTo('#ms-c .ms-dot-ring',\n    { opacity: 0.8, scale: 0.6 },\n    { opacity: 0, scale: 1.6, duration: 0.55, ease: 'power2.out' },\n    2.8\n  );\n\n  // Progress line draws to 100%\n  tl.to('#axis-progress',\n    { scaleX: 1.0, duration: 0.7, ease: 'expo.out' },\n    2.7\n  );\n\n  // --- BREATHE phase: subtle ambient on dots (finite) ---\n  // Dot A gentle opacity pulse — 2 cycles\n  tl.fromTo('#ms-a .ms-dot',\n    { opacity: 1 },\n    { opacity: 0.6, duration: 0.4, ease: 'sine.inOut', repeat: 3, yoyo: true },\n    3.5\n  );\n\n  // --- EXIT fade at 5.3s ---\n  tl.to('#ladder-wrap',\n    { opacity: 0, duration: 0.5, ease: 'power2.in' },\n    5.3\n  );\n\n  tl.to('#ghost-letters',\n    { opacity: 0, duration: 0.4, ease: 'power2.in' },\n    5.3\n  );\n\n  window.__timelines['career-ladder'] = tl;\n</script>\n</body>\n</html>"
