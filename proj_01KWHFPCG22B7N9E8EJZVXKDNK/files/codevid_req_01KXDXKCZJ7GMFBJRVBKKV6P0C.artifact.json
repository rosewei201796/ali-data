al,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:var(--paper);}\ncareer-proof{margin-top:6px;font:600 15px/1.4 'Inter',Arial,sans-serif;color:var(--muted);letter-spacing:.04em;}\n</style>\n</head>\n<body>\n<div id=\"scene\">\n<video id=\"bg\" autoplay muted loop playsinline><source src=\"{{bgVid}}\" type=\"video/mp4\"></video>\n<div id=\"vig\"></div>\n<div class=\"career-ladder\">\n<div class=\"career-axis\"></div>\n<div class=\"career-progress\" id=\"prog\"></div>\n<div class=\"career-point\" id=\"pa\" data-pos=\"a\">\n<div class=\"career-dot\"></div>\n<div class=\"career-year\">2004</div>\n<div class=\"career-fact\">Hawking</div>\n<div class=\"career-proof\">BBC Television Film</div>\n</div>\n<div class=\"career-point\" id=\"pb\" data-pos=\"b\">\n<div class=\"career-dot\"></div>\n<div class=\"career-year\">2010</div>\n<div class=\"career-fact\">Sherlock</div>\n<div class=\"career-proof\">BBC One · Global Breakthrough</div>\n</div>\n<div class=\"career-point\" id=\"pc\" data-pos=\"c\">\n<div class=\"career-dot\"></div>\n<div class=\"career-year\">2016</div>\n<div class=\"career-fact\">Doctor Strange</div>\n<div class=\"career-proof\">Marvel Studios · MCU</div>\n</div>\n</div>\n</div>\n<script src=\"vendor/gsap.min.js\"></script>\n<script>\nwindow.addEventListener('DOMContentLoaded',function(){\nvar tl=gsap.timeline()\ntl.to('#pa',{opacity:1,y:0,duration:0.55,ease:'power3.out',startAt:{opacity:0,y:14}},0.4)\ntl.to('#prog',{scaleX:0.5,duration:0.7,ease:'expo.out'},0.7)\ntl.to('#pb',{opacity:1,y:0,duration:0.55,ease:'power3.out',startAt:{opacity:0,y:14}},1.2)\ntl.to('#prog',{scaleX:1.0,duration:0.7,ease:'expo.out'},1.5)\ntl.to('#pc',{opacity:1,y:0,duration:0.55,ease:'power3.out',startAt:{opacity:0,y:14}},2.0)\n/* exit */\ntl.to('.career-ladder',{opacity:0,duration:0.5,ease:'power2.in'},5.3)\n})\n</script>\n</body>\n</html>\n```",
