-right {\n    position: absolute;\n    top: 0; right: 0;\n    width: 320px; height: 100%;\n    background: radial-gradient(ellipse at 100% 50%, rgba(180,40,10,0.18) 0%, transparent 70%);\n    z-index: 2;\n    opacity: 0;\n  }\n\n  /* PiP window wrapper — centered */\n  #win-wrap {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    z-index: 10;\n    opacity: 0;\n    /* GSAP will handle transform; set origin offsets via marginLeft/marginTop so GSAP x/y work cleanly */\n    margin-top: -285px;\n    margin-left: -490px;\n  }\n\n  /* Horizontal lines above/below */\n  #win-top-line {\n    width: 0;\n    height: 2px;\n    background: rgba(240,236,228,0.40);\n    margin-bottom: 0;\n  }\n\n  #win {\n    width: 980px;\n    height: 551px;\n    overflow: hidden;\n    position: relative;\n  }\n\n  #win video {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n\n  /* Inner vignette overlay on video */\n  #win-inner-vignette {\n    position: absolute;\n    top: 0; left: 0;\n    width: 100%; height: 100%;\n    box-shadow: inset 0 0 80px rgba(20,2,2,0.65);\n    pointer-events: none;\n    z-index: 3;\n  }\n\n  /* Thin amber accent line on left edge of PiP */\n  #win-accent-left {\n    position: absolute;\n    left: 0; top: 0;\n    width: 3px;\n    height: 0;\n    background: linear-gradient(to bottom, rgba(255,160,40,0.7), rgba(255,100,20,0.3));\n    z-index: 4;\n  }\n\n  #win-bot-line {\n    width: 0;\n    height: 2px;\n    background: rgba(240,236,228,0.40);\n    margin-top: 0;\n  }\n\n  /* Metadata label strip below */\n  #meta-strip {\n    display: flex;\n    align-items: center;\n    gap: 24px;\n    margin-top: 14px;\n    opacity: 0;\n  }\n\n  #meta-dot {\n    width: 8px;\n    height: 8px;\n    border-radius: 50%;\n    background: rgba(255,140,40,0.7);\n    flex-shrink: 0;\n  }\n\n  #meta-text {\n    font-family: monospace;\n    font-size: 18px;\n    letter-spacing: 0.12em;\n    color: rgba(240,220,180,0.45);\n    text-transform: 