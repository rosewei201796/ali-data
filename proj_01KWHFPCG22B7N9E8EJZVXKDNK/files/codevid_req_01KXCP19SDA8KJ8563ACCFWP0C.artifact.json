!-- right tick -->\n<line id=\"tick-r\" x1=\"1720\" y1=\"713\" x2=\"1720\" y2=\"727\"\nstroke=\"#963f43\" stroke-width=\"2\" opacity=\"0\"/>\n<!-- left label dot -->\n<circle id=\"dot-l\" cx=\"200\" cy=\"720\" r=\"4\" fill=\"#963f43\" opacity=\"0\"/>\n<circle id=\"dot-r\" cx=\"1720\" cy=\"720\" r=\"4\" fill=\"#963f43\" opacity=\"0\"/>\n</svg>\n<div id=\"label\">\n<div id=\"lbl-main\">THE STAGE</div>\n<div id=\"lbl-sub\">EARLY CRAFT</div>\n</div>\n</div>\n<script src=\"vendor/gsap.min.js\"></script>\n<script>\nwindow.addEventListener('DOMContentLoaded',function(){\nvar tl=gsap.timeline()\n/* dots appear */\ntl.to('#dot-l',{opacity:1,duration:0.25,ease:'power2.out'},0.5)\ntl.to('#dot-r',{opacity:1,duration:0.25,ease:'power2.out'},0.55)\n/* line draws left to right via x2 */\ntl.to('#hline',{opacity:1,duration:0.01},0.5)\ngsap.set('#hline',{attr:{x2:200}})\ntl.to('#hline',{attr:{x2:1720},duration:0.7,ease:'expo.out'},0.5)\n/* ticks appear */\ntl.to('#tick-l',{opacity:1,duration:0.3,ease:'power2.out'},0.8)\ntl.to('#tick-r',{opacity:1,duration:0.3,ease:'power2.out'},0.85)\n/* label fades in — 0.3s after geometry */\ntl.to('#label',{opacity:1,duration:0.45,ease:'power2.out'},0.9)\n/* hold then fade out */\ntl.to(['#svg-layer','#label'],{opacity:0,duration:0.5,ease:'power2.in'},5.2)\n})\n</script>\n</body>\n</html>\n```",
