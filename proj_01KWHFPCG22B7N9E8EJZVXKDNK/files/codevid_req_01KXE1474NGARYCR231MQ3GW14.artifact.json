lor: rgba(243, 238, 229, 0.80);\n    letter-spacing: 0.02em;\n  }\n\n  /* Grid */\n  #grid {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    z-index: 10;\n    display: grid;\n    grid-template-columns: 1fr 1fr 1fr;\n    gap: 14px;\n    width: 1640px;\n    height: 820px;\n    /* CSS translate for centering — not mixed with GSAP on this element */\n    transform: translate(-50%, -46%);\n  }\n\n  /* Card wrappers */\n  .card-wrap {\n    position: relative;\n    overflow: hidden;\n    background: #000;\n    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.65);\n    clip-path: polygon(0 0, 100% 0, 100% 0, 0 0);\n  }\n\n  .card-wrap img {\n    width: 100%;\n    height: 110%;\n    display: block;\n    object-fit: cover;\n    object-position: center top;\n  }\n\n  /* Dark gradient overlay */\n  .card-overlay {\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(to top, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.18) 52%, transparent 100%);\n    z-index: 2;\n    pointer-events: none;\n  }\n\n  /* Accent line top of card */\n  .card-accent {\n    position: absolute;\n    top: 0;\n    left: 0;\n    right: 0;\n    height: 3px;\n    background: #d72f2f;\n    z-index: 4;\n    transform-origin: left center;\n  }\n\n  /* Role label */\n  .role-label {\n    position: absolute;\n    bottom: 0;\n    left: 0;\n    right: 0;\n    z-index: 10;\n    padding: 32px 32px 36px;\n  }\n\n  .role-kicker {\n    font-family: 'DM Sans', sans-serif;\n    font-size: 16px;\n    font-weight: 600;\n    letter-spacing: 0.30em;\n    text-transform: uppercase;\n    color: #d72f2f;\n    margin-bottom: 10px;\n    display: block;\n  }\n\n  .role-name {\n    font-family: 'DM Serif Display', Georgia, serif;\n    font-size: 52px;\n    font-weight: 400;\n    color: #f3eee5;\n    line-height: 1.05;\n    letter-spacing: -0.02em;\n    display: block;\n  }\n\n  .role-year {\n    font-family: 'DM Sans', sans-serif;\n    font-size: 20px;\n    font-weight: 300;\n    color: rgba(243, 238, 229, 0.58);\n    