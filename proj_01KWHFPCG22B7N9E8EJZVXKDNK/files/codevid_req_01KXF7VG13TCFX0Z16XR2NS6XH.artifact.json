lity: hidden;\n  }\n\n  /* Card image area */\n  .card-img {\n    width: calc(100% - 20px);\n    height: calc(100% - 20px);\n    margin: 10px;\n    overflow: hidden;\n    border-radius: 4px;\n    position: relative;\n  }\n\n  .card-img img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n    filter: contrast(1.08) saturate(0.92);\n  }\n\n  /* Shimmer highlight on card */\n  .card-shimmer {\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n    z-index: 3;\n    border-radius: 8px;\n    background: linear-gradient(\n      135deg,\n      rgba(255,255,255,0) 0%,\n      rgba(255,255,255,0.18) 40%,\n      rgba(255,255,255,0) 60%\n    );\n    opacity: 0;\n  }\n\n  /* Name label */\n  .name-label {\n    margin-top: 32px;\n    text-align: center;\n    opacity: 0;\n  }\n\n  .name-text {\n    font-family: 'Crimson Pro', Georgia, serif;\n    font-size: 72px;\n    font-weight: 700;\n    color: #f2ede4;\n    letter-spacing: -0.03em;\n    line-height: 1;\n    text-shadow: 0 4px 32px rgba(0,0,0,0.8);\n  }\n\n  /* Decorative line under name */\n  .name-line {\n    width: 0;\n    height: 2px;\n    background: rgba(242,237,228,0.45);\n    margin: 14px auto 0;\n    border-radius: 1px;\n  }\n\n  /* Open/close fades */\n  #open-fade,\n  #close-fade {\n    position: absolute;\n    inset: 0;\n    z-index: 50;\n    background: #000000;\n    pointer-events: none;\n  }\n\n  #open-fade  { opacity: 1; }\n  #close-fade { opacity: 0; }\n</style>\n</head>\n<body>\n\n<div id=\"root-comp\"\n     data-composition-id=\"card-showcase\"\n     data-start=\"0\"\n     data-width=\"1920\"\n     data-height=\"1080\"\n     data-duration=\"16\"\n     data-track-index=\"0\">\n\n  <!-- Background -->\n  <div class=\"bg-glow\" id=\"bg-glow\">\n    <div class=\"bg-glow-inner\" id=\"bg-glow-inner\"></div>\n  </div>\n  <div class=\"vignette\"></div>\n\n  <!-- Scene 1: Alan Turing -->\n  <div class=\"card-stage\" id=\"s1\">\n    <div class=\"card-wrap\" id=\"cw1\">