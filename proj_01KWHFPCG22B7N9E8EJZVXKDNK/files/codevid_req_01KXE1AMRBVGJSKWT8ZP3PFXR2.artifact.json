    "index.html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Playfair+Display+SC:wght@400;700&family=Manrope:wght@600;700&display=swap\">\n<style>\n  *, *::before, *::after {\n    margin: 0;\n    padding: 0;\n    box-sizing: border-box;\n  }\n\n  :root {\n    --black: #1c1f33;\n    --gray: #eeeeee;\n    --red: #d72f2f;\n    --font-title: 'Playfair Display SC', serif;\n    --font-sans: 'Manrope', sans-serif;\n  }\n\n  body, html {\n    width: 1920px;\n    height: 1080px;\n    overflow: hidden;\n    background: var(--black);\n  }\n\n  #comp-root {\n    position: relative;\n    width: 1920px;\n    height: 1080px;\n    overflow: hidden;\n    background: var(--black);\n  }\n\n  /* Background video */\n  #bg-vid {\n    position: absolute;\n    top: 0; left: 0;\n    width: 100%; height: 100%;\n    object-fit: cover;\n    z-index: 1;\n    filter: grayscale(85%) contrast(1.05) brightness(0.42);\n    opacity: 0;\n  }\n\n  /* Paper grain texture overlay */\n  #paper-grain {\n    position: absolute;\n    top: 0; left: 0;\n    width: 100%; height: 100%;\n    z-index: 2;\n    background: repeating-linear-gradient(\n      0deg,\n      transparent,\n      transparent 3px,\n      rgba(28,31,51,0.07) 3px,\n      rgba(28,31,51,0.07) 4px\n    );\n    pointer-events: none;\n  }\n\n  /* Gradient vignette */\n  #grad-vignette {\n    position: absolute;\n    bottom: 0; left: 0;\n    width: 100%; height: 72%;\n    z-index: 3;\n    background: linear-gradient(\n      to top,\n      rgba(28,31,51,0.97) 0%,\n      rgba(28,31,51,0.58) 52%,\n      transparent 100%\n    );\n    pointer-events: none;\n  }\n\n  /* Radial ambient glow at center */\n  #center-glow {\n    position: absolute;\n    top: 50%; left: 50%;\n    width: 900px;\n    height: 600px;\n    z-index: 4;\n    background: radial-gradient(ellipse at center, rgba(238,238,238,0.04) 0%, transparent 70%);\n    transform: translate(-50%, -50%);\n    pointer-events: none;\n    opacity: 0;\n  }\n\n  /* Frame wrapper — uses a wrapper to avoid transform conflicts */\n  #frame-wrapper {\n    position: absolute;\n    top: 50%; left: 50%;\n    z-index: 10;\n    opacity: 0;\n  }\n\n  /* The actual double-border frame */\n  #frame-inner {\n    position: relative;\n    transform: translate(-50%, -50%);\n    border: 2px solid rgba(238,238,238,0.68);\n    outline: none;\n    box-shadow:\n      0 0 0 6px rgba(28,31,51,0.0),\n      inset 0 0 0 1px rgba(238,238,238,0.28);\n    padding: 52px 80px 60px;\n    text-align: center;\n    min-width: 860px;\n    background: rgba(28,31,51,0.18);\n  }\n\n  /* Inner border line — second border via pseudo */\n  #frame-inner::before {\n    content: '';\n    position: absolute;\n    inset: 8px;\n    border: 1px solid rgba(238,238,238,0.32);\n    pointer-events: none;\n  }\n\n  /* Kicker */\n  #kicker {\n    font-family: var(--font-sans);\n    font-weight: 700;\n    font-size: 16px;\n    line-height: 1;\n    letter-spacing: 0.42em;\n    text-transform: uppercase;\n    color: var(--red);\n    margin-bottom: 24px;\n    opacity: 0;\n  }\n\n  /* Headline container */\n  #headline-block {\n    font-family: var(--font-title);\n    font-weight: 400;\n    font-size: 96px;\n    line-height: 0.92;\n    letter-spacing: -0.02em;\n    text-transform: uppercase;\n    color: var(--gray);\n    margin-bottom: 4px;\n  }\n\n  /* Animated line clip containers */\n  .anim-line {\n    display: block;\n    overflow: hidden;\n    line-height: 1.0;\n  }\n\n  .anim-line-inner {\n    display: block;\n    transform: translateY(110%);\n    opacity: 0;\n  }\n\n  /* Decorative rule */\n  #rule-line {\n    width: 100%;\n    height: 1px;\n    background: rgba(238,238,238,0.35);\n    margin: 26px 0 22px;\n    transform-origin: left center;\n    transform: scaleX(0);\n    opacity: 0;\n  }\n\n  /* Tagline */\n  #tagline-wrap {\n    overflow: hidden;\n    line-height: 1.35;\n  }\n\n  #tagline-inner {\n    font-family: var(--font-title);\n    font-weight: 400;\n    font-style: italic;\n    font-size: 26px;\n    line-height: 1.35;\n    letter-spacing: 0.04em;\n    color: rgba(238,238,238,0.62);\n    transform: translateY(110%);\n    opacity: 0;\n    display: block;\n  }\n\n  /* Final fade overlay */\n  #fade-overlay {\n    position: absolute;\n    inset: 0;\n    z-index: 50;\n    background: var(--black);\n    opacity: 0;\n    pointer-events: none;\n  }\n</style>\n</head>\n<body>\n<div id=\"comp-root\"\n     data-composition-id=\"closing-title-card\"\n     data-start=\"0\"\n     data-duration=\"9\"\n     data-width=\"1920\"\n     data-height=\"1080\"\n     data-track-index=\"0\">\n\n  <!-- Background video -->\n  <video id=\"bg-vid\"\n         src=\"assets/bgVid.mp4\"\n         muted\n         playsinline\n         loop\n         data-start=\"0\"\n         data-track-index=\"1\">\n  </video>\n\n  <!-- Paper grain -->\n  <div id=\"paper-grain\"></div>\n\n  <!-- Gradient vignette -->\n  <div id=\"grad-vignette\"></div>\n\n  <!-- Ambient glow -->\n  <div id=\"center-glow\"></div>\n\n  <!-- Frame wrapper positioned at center -->\n  <div id=\"frame-wrapper\">\n    <div id=\"frame-inner\">\n\n      <div id=\"kicker\">The Biographical Record</div>\n\n      <div id=\"headline-block\">\n        <span class=\"anim-line\">\n          <span class=\"anim-line-inner\" id=\"h-line-1\">Benedict</span>\n        </span>\n        <span class=\"anim-line\">\n          <span class=\"anim-line-inner\" id=\"h-line-2\">Cumberbatch</span>\n        </span>\n      </div>\n\n      <div id=\"rule-line\"></div>\n\n      <div id=\"tagline-wrap\">\n        <span id=\"tagline-inner\">History, one life at a time.</span>\n      </div>\n\n    </div>\n  </div>\n\n  <!-- Final fade to black -->\n  <div id=\"fade-overlay\"></div>\n\n</div>\n\n<script src=\"vendor/gsap.min.js\"></script>\n<script>\n  window.__timelines = window.__timelines || {};\n\n  const tl = gsap.timeline({ paused: true });\n\n  // --- BUILD PHASE (0 – 2.7s) ---\n\n  // Video fades in\n  tl.fromTo('#bg-vid',\n    { opacity: 0 },\n    { opacity: 1, duration: 1.2, ease: 'power2.out' },\n    0.0\n  );\n\n  // Ambient glow blooms\n  tl.fromTo('#center-glow',\n    { opacity: 0 },\n    { opacity: 1, duration: 1.5, ease: 'power2.out' },\n    0.2\n  );\n\n  // Frame wrapper lifts in (y tween on wrapper, translate on inner handles centering)\n  tl.fromTo('#frame-wrapper',\n    { opacity: 0, y: 28 },\n    { opacity: 1, y: 0, duration: 0.75, ease: 'power3.out' },\n    0.45\n  );\n\n  // Kicker fades in\n  tl.fromTo('#kicker',\n    { opacity: 0 },\n    { opacity: 1, duration: 0.5, ease: 'power2.out' },\n    0.6\n  );\n\n  // Headline line 1 — RISES up into view\n  tl.fromTo('#h-line-1',\n    { y: '110%', opacity: 0 },\n    { y: '0%', opacity: 1, duration: 0.75, ease: 'power4.out' },\n    0.82\n  );\n\n  // Headline line 2 — slightly staggered\n  tl.fromTo('#h-line-2',\n    { y: '110%', opacity: 0 },\n    { y: '0%', opacity: 1, duration: 0.75, ease: 'power4.out' },\n    0.97\n  );\n\n  // Rule DRAWS from left\n  tl.fromTo('#rule-line',\n    { scaleX: 0, opacity: 0 },\n    { scaleX: 1, opacity: 1, duration: 0.55, ease: 'expo.out' },\n    1.48\n  );\n\n  // Tagline RISES\n  tl.fromTo('#tagline-inner',\n    { y: '110%', opacity: 0 },\n    { y: '0%', opacity: 1, duration: 0.65, ease: 'power3.out' },\n    1.78\n  );\n\n  // --- BREATHE PHASE (2.7s – 7.1s) ---\n  // Subtle ambient glow pulse — finite, seekable\n  tl.fromTo('#center-glow',\n    { opacity: 1 },\n    { opacity: 0.55, duration: 1.8, ease: 'sine.inOut', repeat: 2, yoyo: true },\n    2.8\n  );\n\n  // --- RESOLVE PHASE (7.1s – 9s) ---\n\n  // Frame lifts and fades out\n  tl.to('#frame-wrapper', {\n    opacity: 0,\n    y: -20,\n    duration: 0.62,\n    ease: 'power2.in'\n  }, 7.1);\n\n  // Video dims\n  tl.to('#bg-vid', {\n    opacity: 0,\n    duration: 0.8,\n    ease: 'power2.in'\n  }, 7.2);\n\n  // Full fade to black\n  tl.fromTo('#fade-overlay',\n    { opacity: 0 },\n    { opacity: 1, duration: 1.65, ease: 'power2.inOut' },\n    7.35\n  );\n\n  window.__timelines['closing-title-card'] = tl;\n</script>\n</body>\n</html>"
