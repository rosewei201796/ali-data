    "index.html": "<!doctype html>\n<html>\n<head>\n<meta charset=\"utf-8\" />\n<title>Benedict Cumberbatch – Origins Name Card</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n<link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&display=swap\" rel=\"stylesheet\" />\n<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n\n  body {\n    width: 1920px;\n    height: 1080px;\n    overflow: hidden;\n    background: #000;\n  }\n\n  #composition-root {\n    position: relative;\n    width: 1920px;\n    height: 1080px;\n    overflow: hidden;\n  }\n\n  /* ── Background video ── */\n  #bg-video {\n    position: absolute;\n    top: 0; left: 0;\n    width: 1920px;\n    height: 1080px;\n    object-fit: cover;\n    z-index: 1;\n  }\n\n  /* ── Frosted glass overlay ── */\n  #frost-overlay {\n    position: absolute;\n    top: 0; left: 0;\n    width: 1920px;\n    height: 1080px;\n    backdrop-filter: blur(18px);\n    -webkit-backdrop-filter: blur(18px);\n    background: rgba(8, 8, 12, 0.62);\n    z-index: 2;\n  }\n\n  /* ── Decorative corner marks ── */\n  .corner-mark {\n    position: absolute;\n    width: 40px;\n    height: 40px;\n    z-index: 4;\n    opacity: 0.35;\n  }\n  .corner-mark.tl { top: 48px; left: 64px; border-top: 2px solid #8b2e2e; border-left: 2px solid #8b2e2e; }\n  .corner-mark.tr { top: 48px; right: 64px; border-top: 2px solid #8b2e2e; border-right: 2px solid #8b2e2e; }\n  .corner-mark.bl { bottom: 48px; left: 64px; border-bottom: 2px solid #8b2e2e; border-left: 2px solid #8b2e2e; }\n  .corner-mark.br { bottom: 48px; right: 64px; border-bottom: 2px solid #8b2e2e; border-right: 2px solid #8b2e2e; }\n\n  /* ── Ghost background text ── */\n  #ghost-text {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    width: 1600px;\n    text-align: center;\n    font-family: Georgia, serif;\n    font-size: 260px;\n    font-weight: 700;\n    letter-spacing: -0.04em;\n    color: rgba(139, 46, 46, 0.055);\n    pointer-events: none;\n    z-index: 3;\n    white-space: nowrap;\n    transform: translate(-50%, -50%);\n    user-select: none;\n  }\n\n  /* ── Thin vertical accent lines ── */\n  .v-line {\n    position: absolute;\n    width: 1px;\n    height: 320px;\n    top: 50%;\n    transform: translateY(-50%);\n    background: rgba(139, 46, 46, 0.18);\n    z-index: 4;\n  }\n  .v-line.left { left: 220px; }\n  .v-line.right { right: 220px; }\n\n  /* ── Main content wrapper ── */\n  #content-wrapper {\n    position: absolute;\n    top: 0; left: 0;\n    width: 1920px;\n    height: 1080px;\n    z-index: 5;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n  }\n\n  /* ── Block 1: ORIGINS label ── */\n  #block-origins {\n    position: absolute;\n    top: calc(18% - 10px);\n    left: 50%;\n    display: flex;\n    align-items: center;\n    gap: 22px;\n    /* GSAP will handle transform, no CSS translate */\n  }\n\n  .origins-line {\n    width: 80px;\n    height: 1px;\n    background: #8b2e2e;\n    flex-shrink: 0;\n  }\n\n  #origins-label {\n    font-family: Georgia, serif;\n    font-style: italic;\n    font-weight: 400;\n    font-size: 22px;\n    color: #8b2e2e;\n    letter-spacing: 0.45em;\n    text-transform: uppercase;\n    white-space: nowrap;\n  }\n\n  /* ── Block 2: Parents ── */\n  #block-parents {\n    position: absolute;\n    top: 36%;\n    left: 50%;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    /* GSAP handles transform */\n  }\n\n  /* Entry A – Father */\n  #entry-father {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 0;\n  }\n\n  .parent-label {\n    font-family: Georgia, serif;\n    font-size: 18px;\n    letter-spacing: 0.35em;\n    color: rgba(180, 165, 145, 0.70);\n    text-transform: uppercase;\n    margin-bottom: 8px;\n  }\n\n  .parent-name {\n    font-family: Georgia, serif;\n    font-weight: 700;\n    font-size: 72px;\n    color: #f0ece4;\n    letter-spacing: 0.08em;\n    line-height: 1;\n    text-align: center;\n  }\n\n  .parent-sub {\n    font-family: Georgia, serif;\n    font-style: italic;\n    font-size: 24px;\n    color: rgba(200, 188, 172, 0.75);\n    margin-top: 10px;\n    letter-spacing: 0.04em;\n    text-align: center;\n  }\n\n  /* Divider */\n  #parents-divider {\n    width: 280px;\n    height: 1px;\n    background: rgba(139, 46, 46, 0.45);\n    margin: 28px auto;\n    transform-origin: center;\n  }\n\n  /* Entry B – Mother */\n  #entry-mother {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 0;\n  }\n\n  /* ── Block 3: Key fact ── */\n  #block-keyfact {\n    position: absolute;\n    top: 68%;\n    left: 50%;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 16px;\n  }\n\n  #keyfact-dot {\n    width: 8px;\n    height: 8px;\n    border-radius: 50%;\n    background: #8b2e2e;\n    flex-shrink: 0;\n  }\n\n  #keyfact-text {\n    font-family: Georgia, serif;\n    font-style: italic;\n    font-size: 26px;\n    letter-spacing: 0.18em;\n    color: rgba(210, 200, 185, 0.80);\n    white-space: nowrap;\n    text-align: center;\n  }\n\n  /* ── Block 4: Paradox line ── */\n  #block-paradox {\n    position: absolute;\n    top: 80%;\n    left: 50%;\n    /* GSAP handles transform */\n  }\n\n  #paradox-text {\n    font-family: Georgia, serif;\n    font-style: italic;\n    font-size: 28px;\n    color: rgba(240, 236, 228, 0.60);\n    letter-spacing: 0.05em;\n    white-space: nowrap;\n    text-align: center;\n  }\n\n  /* ── Exit wrapper (fades out) ── */\n  #overlay-group {\n    position: absolute;\n    top: 0; left: 0;\n    width: 1920px;\n    height: 1080px;\n    z-index: 2;\n  }\n\n</style>\n</head>\n<body>\n\n<div\n  id=\"composition-root\"\n  data-composition-id=\"bc-origins-card\"\n  data-start=\"0\"\n  data-duration=\"9\"\n  data-width=\"1920\"\n  data-height=\"1080\"\n  data-track-index=\"0\"\n>\n\n  <!-- Background video -->\n  <video\n    id=\"bg-video\"\n    src=\"assets/bgVideo.mp4\"\n    muted\n    playsinline\n    loop\n    data-start=\"0\"\n    data-track-index=\"1\"\n  ></video>\n\n  <!-- Everything that fades out at end lives in this group -->\n  <div id=\"overlay-group\">\n\n    <!-- Frosted glass overlay -->\n    <div id=\"frost-overlay\"></div>\n\n    <!-- Ghost background lettering -->\n    <div id=\"ghost-text\">BC</div>\n\n    <!-- Corner registration marks -->\n    <div class=\"corner-mark tl\"></div>\n    <div class=\"corner-mark tr\"></div>\n    <div class=\"corner-mark bl\"></div>\n    <div class=\"corner-mark br\"></div>\n\n    <!-- Vertical accent lines -->\n    <div class=\"v-line left\"></div>\n    <div class=\"v-line right\"></div>\n\n    <!-- Block 1: ORIGINS chapter label -->\n    <div id=\"block-origins\">\n      <div class=\"origins-line\"></div>\n      <div id=\"origins-label\">Origins</div>\n      <div class=\"origins-line\"></div>\n    </div>\n\n    <!-- Block 2: Parents -->\n    <div id=\"block-parents\">\n      <!-- Entry A: Father -->\n      <div id=\"entry-father\">\n        <div class=\"parent-label\">Father</div>\n        <div class=\"parent-name\">TIMOTHY CARLTON</div>\n        <div class=\"parent-sub\">Actor · Born 1939</div>\n      </div>\n\n      <!-- Divider -->\n      <div id=\"parents-divider\"></div>\n\n      <!-- Entry B: Mother -->\n      <div id=\"entry-mother\">\n        <div class=\"parent-label\">Mother</div>\n        <div class=\"parent-name\">WANDA VENTHAM</div>\n        <div class=\"parent-sub\">Actress · Born 1935</div>\n      </div>\n    </div>\n\n    <!-- Block 3: Key fact -->\n    <div id=\"block-keyfact\">\n      <div id=\"keyfact-dot\"></div>\n      <div id=\"keyfact-text\">Born 19 July 1976, Hammersmith, London</div>\n    </div>\n\n    <!-- Block 4: Paradox line -->\n    <div id=\"block-paradox\">\n      <div id=\"paradox-text\">Theatre royalty — chosen the world's strangest hero.</div>\n    </div>\n\n  </div><!-- /overlay-group -->\n\n</div><!-- /composition-root -->\n\n<script src=\"vendor/gsap.min.js\"></script>\n<script>\n  window.__timelines = window.__timelines || {};\n\n  const CID = \"bc-origins-card\";\n  const tl = gsap.timeline({ paused: true });\n\n  // ── Set initial states via fromTo for deterministic scrubbing ──\n\n  // Block 1: ORIGINS — starts invisible, fades in at 0.4s\n  tl.fromTo(\"#block-origins\",\n    { opacity: 0, x: \"-50%\" },\n    { opacity: 1, x: \"-50%\", duration: 0.5, ease: \"power2.out\" },\n    0.4\n  );\n\n  // Block 2: Entry A (Father) — fade + slide in at 0.9s\n  tl.fromTo(\"#entry-father\",\n    { opacity: 0, y: 12 },\n    { opacity: 1, y: 0, duration: 0.6, ease: \"power2.out\" },\n    0.9\n  );\n\n  // Block 2: Parent block container — needs x centering established before entries animate\n  // Set the container translateX at time 0 so it's centered throughout\n  tl.set(\"#block-parents\", { x: \"-50%\", opacity: 1 }, 0);\n\n  // Divider: scaleX 0→1 at 1.5s\n  tl.fromTo(\"#parents-divider\",\n    { scaleX: 0, opacity: 1 },\n    { scaleX: 1, duration: 0.4, ease: \"power2.out\" },\n    1.5\n  );\n\n  // Entry B (Mother) — fade + slide in at 1.7s\n  tl.fromTo(\"#entry-mother\",\n    { opacity: 0, y: 12 },\n    { opacity: 1, y: 0, duration: 0.6, ease: \"power2.out\" },\n    1.7\n  );\n\n  // Block 3: Dot appears at 2.5s\n  tl.fromTo(\"#keyfact-dot\",\n    { opacity: 0, x: \"-50%\", y: \"-50%\" },\n    { opacity: 1, x: \"-50%\", y: \"-50%\", duration: 0.4, ease: \"power1.out\" },\n    2.5\n  );\n\n  // Block 3: Key fact text fades at 2.8s\n  tl.fromTo(\"#keyfact-text\",\n    { opacity: 0, x: \"-50%\" },\n    { opacity: 1, x: \"-50%\", duration: 0.6, ease: \"power2.out\" },\n    2.8\n  );\n\n  // Block 4: Paradox line fades at 3.5s\n  tl.fromTo(\"#block-paradox\",\n    { opacity: 0, x: \"-50%\" },\n    { opacity: 1, x: \"-50%\", duration: 0.8, ease: \"power2.out\" },\n    3.5\n  );\n\n  // ── Hold: everything fully visible 4.5s → 8.2s ──\n\n  // ── Exit: entire overlay group fades out at 8.2s, duration 0.7s ──\n  tl.to(\"#overlay-group\",\n    { opacity: 0, duration: 0.7, ease: \"power2.inOut\" },\n    8.2\n  );\n\n  // ── Set initial hidden states for elements that need centering ──\n  // Use tl.set at time 0 for elements that use x:\"-50%\" centering\n  // Already handled in fromTo calls above; also hide keyfact-dot and keyfact-text block:\n  tl.set(\"#block-keyfact\", { x: \"-50%\" }, 0);\n\n  window.__timelines[CID] = tl;\n</script>\n\n<style>\n  /* Override initial visibility for elements animated by GSAP */\n  #block-origins {\n    opacity: 0;\n  }\n  #entry-father {\n    opacity: 0;\n  }\n  #parents-divider {\n    transform-origin: center;\n    transform: scaleX(0);\n  }\n  #entry-mother {\n    opacity: 0;\n  }\n  #keyfact-dot {\n    opacity: 0;\n    position: absolute;\n    top: 0;\n    left: 50%;\n  }\n  #keyfact-text {\n    opacity: 0;\n  }\n  #block-paradox {\n    opacity: 0;\n  }\n\n  /* Fix keyfact layout — dot needs special positioning */\n  #block-keyfact {\n    position: absolute;\n    top: 68%;\n    left: 50%;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 16px;\n  }\n\n  #keyfact-dot {\n    position: relative;\n    top: auto;\n    left: auto;\n    transform: none;\n  }\n</style>\n\n</body>\n</html>"
