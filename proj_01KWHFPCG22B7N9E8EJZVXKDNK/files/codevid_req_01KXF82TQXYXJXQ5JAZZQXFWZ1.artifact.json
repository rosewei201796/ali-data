    "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&display=swap\">\n<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n\n  body {\n    width: 1920px;\n    height: 1080px;\n    overflow: hidden;\n    background: #000;\n  }\n\n  #root-comp {\n    position: relative;\n    width: 1920px;\n    height: 1080px;\n    overflow: hidden;\n    background: #000000;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  /* Background radial glow — always visible, subtle texture */\n  .bg-glow {\n    position: absolute;\n    inset: 0;\n    background:\n      radial-gradient(ellipse 900px 600px at 50% 50%, rgba(60,50,40,0.18) 0%, rgba(0,0,0,0) 70%);\n    pointer-events: none;\n    z-index: 0;\n  }\n\n  /* Ghost lettering background texture */\n  .bg-ghost {\n    position: absolute;\n    inset: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    z-index: 0;\n    pointer-events: none;\n  }\n  .bg-ghost-text {\n    font-family: 'DM Serif Display', Georgia, serif;\n    font-size: 420px;\n    font-weight: 400;\n    color: rgba(255,255,255,0.025);\n    letter-spacing: -0.05em;\n    line-height: 1;\n    white-space: nowrap;\n    user-select: none;\n  }\n\n  /* Card stages — each occupies center of the scene */\n  .card-stage {\n    position: absolute;\n    top: 0; left: 0;\n    width: 1920px;\n    height: 1080px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    opacity: 0;\n    z-index: 2;\n  }\n\n  /* Card wrap — holds the rocking animation via GSAP */\n  .card-wrap {\n    width: 340px;\n    height: 490px;\n    position: relative;\n    transform-style: preserve-3d;\n    /* perspective set on parent */\n    perspective: 900px;\n    will-change: transform;\n  }\n\n  .card-face {\n    width: 100%;\n    height: 100%;\n    background: #fff;\n    border-radius: 8px;\n    box-shadow:\n      0 50px 100px rgba(0,0,0,0.90),\n      0 12px 30px rgba(0,0,0,0.60),\n      0 0 0 1px rgba(255,255,255,0.08);\n    overflow: hidden;\n    position: relative;\n    transform-style: preserve-3d;\n  }\n\n  .card-img {\n    width: calc(100% - 20px);\n    height: calc(100% - 20px);\n    margin: 10px;\n    overflow: hidden;\n    border-radius: 4px;\n    position: relative;\n  }\n\n  .card-img img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n    filter: grayscale(12%) contrast(1.08) brightness(0.97);\n  }\n\n  /* Specular sheen overlay — driven by GSAP alongside rock */\n  .card-sheen {\n    position: absolute;\n    left: 0; top: 0;\n    width: 100%;\n    height: 100%;\n    pointer-events: none;\n    border-radius: 8px;\n    overflow: hidden;\n  }\n  .card-sheen::after {\n    content: \"\";\n    position: absolute;\n    left: -40%;\n    top: -10%;\n    width: 80%;\n    padding-bottom: 80%;\n    border-radius: 50%;\n    background: radial-gradient(ellipse at center, rgba(255,255,255,0.28) 0%, rgba(255,255,255,0) 70%);\n    pointer-events: none;\n    will-change: transform;\n  }\n\n  /* Name label below the card */\n  .role-label {\n    margin-top: 32px;\n    text-align: center;\n    opacity: 0;\n    will-change: transform, opacity;\n  }\n\n  .role-name {\n    font-family: 'DM Serif Display', Georgia, serif;\n    font-size: 56px;\n    font-weight: 400;\n    font-style: italic;\n    color: #f0ece4;\n    line-height: 1;\n    letter-spacing: -0.02em;\n  }\n\n  /* Fade overlays */\n  #open-fade,\n  #close-fade {\n    position: absolute;\n    inset: 0;\n    z-index: 50;\n    background: #000;\n    pointer-events: none;\n  }\n  #open-fade { opacity: 1; }\n  #close-fade { opacity: 0; }\n</style>\n</head>\n<body>\n<div\n  id=\"root-comp\"\n  data-composition-id=\"card-showcase\"\n  data-start=\"0\"\n  data-duration=\"16\"\n  data-width=\"1920\"\n  data-height=\"1080\"\n  data-track-index=\"0\"\n>\n  <!-- Background texture -->\n  <div class=\"bg-glow\"></div>\n  <div class=\"bg-ghost\"><span class=\"bg-ghost-text\" id=\"bg-ghost-text\">I</span></div>\n\n  <!-- Fade overlays -->\n  <div id=\"open-fade\"></div>\n  <div id=\"close-fade\"></div>\n\n  <!-- Card 1: Alan Turing — track 1, 0–5.5s -->\n  <div class=\"card-stage clip\" id=\"s1\" data-start=\"0\" data-duration=\"5.5\" data-track-index=\"1\">\n    <div class=\"card-wrap\" id=\"cw1\">\n      <div class=\"card-face\">\n        <div class=\"card-img\">\n          <img src=\"assets/img1.jpg\" alt=\"\">\n        </div>\n        <div class=\"card-sheen\" id=\"sheen1\"></div>\n      </div>\n    </div>\n    <div class=\"role-label\" id=\"l1\">\n      <div class=\"role-name\">Alan Turing</div>\n    </div>\n  </div>\n\n  <!-- Card 2: Sherlock Holmes — track 2, 5.5–10.5s -->\n  <div class=\"card-stage clip\" id=\"s2\" data-start=\"5.5\" data-duration=\"5\" data-track-index=\"2\">\n    <div class=\"card-wrap\" id=\"cw2\">\n      <div class=\"card-face\">\n        <div class=\"card-img\">\n          <img src=\"assets/img2.jpg\" alt=\"\">\n        </div>\n        <div class=\"card-sheen\" id=\"sheen2\"></div>\n      </div>\n    </div>\n    <div class=\"role-label\" id=\"l2\">\n      <div class=\"role-name\">Sherlock Holmes</div>\n    </div>\n  </div>\n\n  <!-- Card 3: Hamlet — track 3, 10.5–15.8s -->\n  <div class=\"card-stage clip\" id=\"s3\" data-start=\"10.5\" data-duration=\"5.3\" data-track-index=\"3\">\n    <div class=\"card-wrap\" id=\"cw3\">\n      <div class=\"card-face\">\n        <div class=\"card-img\">\n          <img src=\"assets/img3.jpg\" alt=\"\">\n        </div>\n        <div class=\"card-sheen\" id=\"sheen3\"></div>\n      </div>\n    </div>\n    <div class=\"role-label\" id=\"l3\">\n      <div class=\"role-name\">Hamlet</div>\n    </div>\n  </div>\n</div>\n\n<script src=\"vendor/gsap.min.js\"></script>\n<script>\n(function () {\n  window.__timelines = window.__timelines || {};\n\n  var tl = gsap.timeline({ paused: true });\n\n  var COMP_ID = 'card-showcase';\n\n  // ─── Helpers ───────────────────────────────────────────────────────────────\n\n  // Build a finite rocking sequence on a card-wrap element.\n  // rockStart: timeline time where rocking begins\n  // visibleDuration: how long the card is on screen\n  // The rock oscillates rotateY between -22 and +22 with combined rotateX tilt.\n  // Use fromTo pairs so no immediateRender conflict.\n\n  function addRock(cardEl, sheenEl, rockStart, visibleDuration) {\n    var cycle = 2.4; // seconds per half-oscillation (end-to-end)\n    var repeatCount = Math.floor(visibleDuration / cycle);\n    if (repeatCount < 1) repeatCount = 1;\n\n    // Initial state at rockStart: set to left tilt\n    tl.set(cardEl, {\n      rotationY: -22,\n      rotationX: 6,\n      transformPerspective: 900,\n      transformOrigin: '50% 50%'\n    }, rockStart);\n\n    for (var i = 0; i < repeatCount; i++) {\n      var t = rockStart + i * cycle;\n      var fromY = (i % 2 === 0) ? -22 : 22;\n      var toY   = (i % 2 === 0) ?  22 : -22;\n\n      tl.to(cardEl, {\n        rotationY: toY,\n        rotationX: 6,\n        transformPerspective: 900,\n        duration: cycle,\n        ease: 'sine.inOut'\n      }, t);\n\n      // Sheen moves opposite to rotationY: when card tilts right (rotationY > 0),\n      // highlight is on the left side, and vice versa.\n      if (sheenEl) {\n        var sheenFromX = (fromY < 0) ? '-60%' : '80%';\n        var sheenToX   = (fromY < 0) ? '80%'  : '-60%';\n        tl.fromTo(sheenEl.querySelector ? sheenEl : document.querySelector('#' + sheenEl.id + ' .card-sheen::after') , \n          { /* we'll use a wrapper approach */ }, {}, t\n        );\n        // Since we can't directly tween ::after pseudo, we use the .card-sheen element's translateX as proxy\n        tl.fromTo(sheenEl, {\n          x: (fromY < 0) ? -80 : 120\n        }, {\n          x: (fromY < 0) ? 120 : -80,\n          duration: cycle,\n          ease: 'sine.inOut'\n        }, t);\n      }\n    }\n  }\n\n  // ─── Scene 1: Alan Turing (0 – 5.5s) ──────────────────────────────────────\n  // s1 is a .clip so it handles its own visibility; initial opacity:0 via CSS.\n  // We need to drive opacity through GSAP on the stage itself.\n\n  // Open fade out\n  tl.to('#open-fade', { opacity: 0, duration: 0.5, ease: 'power2.out' }, 0.0);\n\n  // Stage 1 appears\n  tl.set('#s1', { opacity: 1 }, 0.3);\n\n  // Card 1 enters: scale up from below\n  tl.fromTo('#cw1', {\n    scale: 0.78,\n    opacity: 0\n  }, {\n    scale: 1,\n    opacity: 1,\n    duration: 0.65,\n    ease: 'back.out(1.4)'\n  }, 0.3);\n\n  // Rock card 1 for ~4.5s\n  var rock1Start = 0.6;\n  var rock1Duration = 4.2;\n  var rockCycle = 2.4;\n  var rock1Repeats = Math.floor(rock1Duration / rockCycle);\n\n  tl.set('#cw1', {\n    rotationY: -22,\n    rotationX: 6,\n    transformPerspective: 900\n  }, rock1Start);\n\n  for (var i = 0; i < rock1Repeats + 1; i++) {\n    var t = rock1Start + i * rockCycle;\n    var toY = (i % 2 === 0) ? 22 : -22;\n    tl.to('#cw1', {\n      rotationY: toY,\n      rotationX: 6,\n      transformPerspective: 900,\n      duration: rockCycle,\n      ease: 'sine.inOut',\n      overwrite: false\n    }, t);\n\n    // Sheen on sheen1 element (moves as translateX behind card)\n    tl.to('#sheen1', {\n      x: (i % 2 === 0) ? 120 : -80,\n      duration: rockCycle,\n      ease: 'sine.inOut'\n    }, t);\n  }\n\n  // Label 1 rises in\n  tl.fromTo('#l1', {\n    opacity: 0,\n    y: 14\n  }, {\n    opacity: 1,\n    y: 0,\n    duration: 0.5,\n    ease: 'power3.out'\n  }, 0.75);\n\n  // Ghost text morphs for scene 1\n  tl.set('#bg-ghost-text', { innerHTML: 'I' }, 0);\n\n  // Label 1 fades out before exit\n  tl.to('#l1', { opacity: 0, y: -10, duration: 0.35, ease: 'power2.in' }, 4.6);\n\n  // Card 1 exit: scale down and fade\n  tl.to('#cw1', { scale: 0.82, opacity: 0, duration: 0.4, ease: 'power2.in' }, 4.7);\n\n  // Kill stage 1\n  tl.set('#s1', { opacity: 0 }, 5.3);\n\n  // ─── Scene 2: Sherlock Holmes (5.5 – 10.5s) ────────────────────────────────\n\n  tl.set('#s2', { opacity: 1 }, 5.4);\n\n  tl.fromTo('#cw2', {\n    scale: 0.78,\n    opacity: 0\n  }, {\n    scale: 1,\n    opacity: 1,\n    duration: 0.65,\n    ease: 'back.out(1.4)'\n  }, 5.4);\n\n  var rock2Start = 5.7;\n  var rock2Duration = 4.2;\n\n  tl.set('#cw2', {\n    rotationY: -22,\n    rotationX: 6,\n    transformPerspective: 900\n  }, rock2Start);\n\n  for (var j = 0; j < Math.floor(rock2Duration / rockCycle) + 1; j++) {\n    var t2 = rock2Start + j * rockCycle;\n    var toY2 = (j % 2 === 0) ? 22 : -22;\n    tl.to('#cw2', {\n      rotationY: toY2,\n      rotationX: 6,\n      transformPerspective: 900,\n      duration: rockCycle,\n      ease: 'sine.inOut'\n    }, t2);\n\n    tl.to('#sheen2', {\n      x: (j % 2 === 0) ? 120 : -80,\n      duration: rockCycle,\n      ease: 'sine.inOut'\n    }, t2);\n  }\n\n  tl.fromTo('#l2', {\n    opacity: 0,\n    y: 14\n  }, {\n    opacity: 1,\n    y: 0,\n    duration: 0.5,\n    ease: 'power3.out'\n  }, 5.95);\n\n  tl.to('#l2', { opacity: 0, y: -10, duration: 0.35, ease: 'power2.in' }, 9.6);\n  tl.to('#cw2', { scale: 0.82, opacity: 0, duration: 0.4, ease: 'power2.in' }, 9.7);\n  tl.set('#s2', { opacity: 0 }, 10.3);\n\n  // ─── Scene 3: Hamlet (10.5 – 15.8s) ───────────────────────────────────────\n\n  tl.set('#s3', { opacity: 1 }, 10.4);\n\n  tl.fromTo('#cw3', {\n    scale: 0.78,\n    opacity: 0\n  }, {\n    scale: 1,\n    opacity: 1,\n    duration: 0.65,\n    ease: 'back.out(1.4)'\n  }, 10.4);\n\n  var rock3Start = 10.7;\n  var rock3Duration = 4.4;\n\n  tl.set('#cw3', {\n    rotationY: -22,\n    rotationX: 6,\n    transformPerspective: 900\n  }, rock3Start);\n\n  for (var k = 0; k < Math.floor(rock3Duration / rockCycle) + 1; k++) {\n    var t3 = rock3Start + k * rockCycle;\n    var toY3 = (k % 2 === 0) ? 22 : -22;\n    tl.to('#cw3', {\n      rotationY: toY3,\n      rotationX: 6,\n      transformPerspective: 900,\n      duration: rockCycle,\n      ease: 'sine.inOut'\n    }, t3);\n\n    tl.to('#sheen3', {\n      x: (k % 2 === 0) ? 120 : -80,\n      duration: rockCycle,\n      ease: 'sine.inOut'\n    }, t3);\n  }\n\n  tl.fromTo('#l3', {\n    opacity: 0,\n    y: 14\n  }, {\n    opacity: 1,\n    y: 0,\n    duration: 0.5,\n    ease: 'power3.out'\n  }, 10.95);\n\n  tl.to('#l3', { opacity: 0, y: -10, duration: 0.35, ease: 'power2.in' }, 14.6);\n  tl.to('#cw3', { scale: 0.88, opacity: 0, duration: 0.5, ease: 'power2.in' }, 14.7);\n\n  // Close fade\n  tl.to('#close-fade', { opacity: 1, duration: 0.7, ease: 'power2.inOut' }, 14.9);\n  tl.set('#close-fade', { opacity: 1 }, 15.8);\n\n  window.__timelines[COMP_ID] = tl;\n})();\n</script>\n</body>\n</html>"
