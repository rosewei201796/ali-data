laysinline>\n<source src=\"{{bgVid}}\" type=\"video/mp4\">\n</video>\n<div id=\"vig\"></div>\n<div id=\"fade\"></div>\n<div id=\"textblock\">\n<div class=\"mask-line line-eyebrow\" id=\"l0\"><span>The Biographical Record</span></div>\n<div class=\"mask-line line-name-1\" id=\"l1\"><span>Benedict</span></div>\n<div class=\"mask-line line-name-2\" id=\"l2\"><span>Cumberbatch</span></div>\n<div class=\"line-rule\" id=\"rule\"></div>\n<div class=\"mask-line line-tag\" id=\"l3\"><span>History, one life at a time.</span></div>\n</div>\n</div>\n<script src=\"vendor/gsap.min.js\"></script>\n<script>\nwindow.addEventListener('DOMContentLoaded',function(){\nvar tl=gsap.timeline()\ntl.to('#bg',    {opacity:1,duration:1.0,ease:'power2.out'},0.0)\ntl.to('#l0 span',{y:0,opacity:1,duration:0.72,ease:'power4.out'},0.5)\ntl.to('#l1 span',{y:0,opacity:1,duration:0.72,ease:'power4.out'},0.63)\ntl.to('#l2 span',{y:0,opacity:1,duration:0.72,ease:'power4.out'},0.76)\ntl.to('#rule',  {width:320,duration:0.5,ease:'expo.out'},1.15)\ntl.to('#l3 span',{y:0,opacity:1,duration:0.6, ease:'power3.out'},1.4)\n/* exit */\ntl.to('#l3 span',{y:'110%',opacity:0,duration:0.4,ease:'power2.in'},7.0)\ntl.to('#rule',  {width:0,  duration:0.3,ease:'power2.in'},7.1)\ntl.to('#l2 span',{y:'110%',opacity:0,duration:0.4,ease:'power2.in'},7.15)\ntl.to('#l1 span',{y:'110%',opacity:0,duration:0.4,ease:'power2.in'},7.25)\ntl.to('#l0 span',{y:'110%',opacity:0,duration:0.4,ease:'power2.in'},7.35)\ntl.to('#fade',  {opacity:1,duration:1.4,ease:'power2.inOut'},7.5)\n})\n</script>\n</body>\n</html>\n```",
