\n\n      <div class=\"mask-line\" id=\"l3\"><span>History, one life at a time.</span></div>\n\n    </div>\n  </div>\n\n</div>\n\n<script src=\"vendor/gsap.min.js\"></script>\n<script>\n  window.__timelines = window.__timelines || {};\n\n  var tl = gsap.timeline({ paused: true });\n\n  var CID = \"closing-title-card\";\n\n  // ── Initial states (set deterministically at t=0 before any tween) ──\n  tl.set('#bg-video',  { opacity: 0 },            0);\n  tl.set('#l0 span',   { y: '115%', opacity: 1 }, 0);\n  tl.set('#l1 span',   { y: '115%', opacity: 1 }, 0);\n  tl.set('#l2 span',   { y: '115%', opacity: 1 }, 0);\n  tl.set('#rule',      { width: 0 },              0);\n  tl.set('#l3 span',   { y: '115%', opacity: 1 }, 0);\n  tl.set('#fade',      { opacity: 0 },            0);\n\n  // ── ENTER ──\n  // BG fades in\n  tl.to('#bg-video', { opacity: 1, duration: 1.1, ease: 'power2.out' }, 0.0);\n\n  // Eyebrow RISES up into view\n  tl.to('#l0 span', { y: '0%', duration: 0.72, ease: 'power4.out' }, 0.50);\n\n  // Name line 1 RISES\n  tl.to('#l1 span', { y: '0%', duration: 0.72, ease: 'power4.out' }, 0.65);\n\n  // Name line 2 RISES\n  tl.to('#l2 span', { y: '0%', duration: 0.72, ease: 'power4.out' }, 0.78);\n\n  // Rule EXPANDS from center\n  tl.to('#rule',    { width: 340, duration: 0.55, ease: 'expo.out' }, 1.18);\n\n  // Tag RISES\n  tl.to('#l3 span', { y: '0%', duration: 0.60, ease: 'power3.out' }, 1.44);\n\n  // ── BREATHE: 1.8s → 7.0s — content holds, no ambient needed ──\n\n  // ── EXIT ──\n  // Tag drops away\n  tl.to('#l3 span', { y: '115%', duration: 0.40, ease: 'power2.in' }, 7.00);\n\n  // Rule collapses\n  tl.to('#rule',    { width: 0,   duration: 0.30, ease: 'power2.in' }, 7.12);\n\n  // Name 2 drops\n  tl.to('#l2 span', { y: '115%', duration: 0.40, ease: 'power2.in' }, 7.18);\n\n  // Name 1 drops\n  tl.to('#l1 span', { y: '115%', duration: 0.40, ease: 'power2.in' }, 7.28);\n\n  // Eyebrow drops\n  tl.to('#l0 span', { y: '115%', duration: 0.40, ease: 'power2.in