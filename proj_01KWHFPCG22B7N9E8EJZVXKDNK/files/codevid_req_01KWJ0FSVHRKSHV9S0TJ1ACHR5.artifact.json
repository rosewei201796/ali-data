    "index.html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<link href=\"https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,700;1,300&display=swap\" rel=\"stylesheet\">\n<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n\n  body {\n    width: 1920px;\n    height: 1080px;\n    overflow: hidden;\n    background: #000;\n  }\n\n  #comp-root {\n    width: 1920px;\n    height: 1080px;\n    position: relative;\n    overflow: hidden;\n  }\n\n  /* ── Background ── */\n  #bg {\n    position: absolute;\n    inset: 0;\n    background: radial-gradient(ellipse 120% 80% at 50% 60%, #3d0808 0%, #1a0404 45%, #0a0202 100%);\n    z-index: 0;\n  }\n\n  /* Background texture: oversized ghost text */\n  #ghost-text {\n    position: absolute;\n    bottom: -40px;\n    left: 50%;\n    transform: translateX(-50%);\n    font-family: 'Crimson Pro', Georgia, serif;\n    font-size: 340px;\n    font-weight: 700;\n    color: rgba(180, 40, 40, 0.10);\n    letter-spacing: -0.04em;\n    white-space: nowrap;\n    z-index: 1;\n    pointer-events: none;\n    line-height: 1;\n  }\n\n  /* Radial vignette overlay */\n  #vignette {\n    position: absolute;\n    inset: 0;\n    background: radial-gradient(ellipse 90% 90% at 50% 50%, transparent 40%, rgba(0,0,0,0.55) 100%);\n    z-index: 2;\n    pointer-events: none;\n  }\n\n  /* Decorative horizontal rule top */\n  #rule-top {\n    position: absolute;\n    top: 68px;\n    left: 120px;\n    right: 120px;\n    height: 2px;\n    background: linear-gradient(90deg, transparent, rgba(180,60,30,0.5) 20%, rgba(220,120,60,0.7) 50%, rgba(180,60,30,0.5) 80%, transparent);\n    z-index: 3;\n  }\n\n  /* Decorative horizontal rule bottom */\n  #rule-bottom {\n    position: absolute;\n    bottom: 68px;\n    left: 120px;\n    right: 120px;\n    height: 2px;\n    background: linear-gradient(90deg, transparent, rgba(180,60,30,0.5) 20%, rgba(220,120,60,0.7) 50%, rgba(180,60,30,0.5) 80%, transparent);\n    z-index: 3;\n  }\n\n  /* Registration marks */\n  #reg-tl, #reg-tr, #reg-bl, #reg-br {\n    position: absolute;\n    width: 28px;\n    height: 28px;\n    z-index: 3;\n  }\n  #reg-tl { top: 56px; left: 108px; border-top: 2px solid rgba(200,80,40,0.45); border-left: 2px solid rgba(200,80,40,0.45); }\n  #reg-tr { top: 56px; right: 108px; border-top: 2px solid rgba(200,80,40,0.45); border-right: 2px solid rgba(200,80,40,0.45); }\n  #reg-bl { bottom: 56px; left: 108px; border-bottom: 2px solid rgba(200,80,40,0.45); border-left: 2px solid rgba(200,80,40,0.45); }\n  #reg-br { bottom: 56px; right: 108px; border-bottom: 2px solid rgba(200,80,40,0.45); border-right: 2px solid rgba(200,80,40,0.45); }\n\n  /* Meta label top-left */\n  #meta-label {\n    position: absolute;\n    top: 54px;\n    left: 160px;\n    font-family: monospace;\n    font-size: 18px;\n    color: rgba(220,160,100,0.5);\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n    z-index: 4;\n  }\n\n  /* Meta label top-right */\n  #meta-right {\n    position: absolute;\n    top: 54px;\n    right: 160px;\n    font-family: monospace;\n    font-size: 18px;\n    color: rgba(220,160,100,0.5);\n    letter-spacing: 0.12em;\n    z-index: 4;\n  }\n\n  /* ── PiP card wrapper ── centered, z-index above decoratives ── */\n  #pip-wrap {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    z-index: 10;\n    display: flex;\n    flex-direction: column;\n    align-items: flex-start;\n    /* translate is owned entirely by GSAP fromTo, no CSS transform here */\n  }\n\n  /* outer glow ring */\n  #pip-glow {\n    position: absolute;\n    inset: -18px;\n    border-radius: 6px;\n    background: radial-gradient(ellipse 100% 100% at 50% 50%, rgba(220,100,40,0.18) 0%, transparent 70%);\n    z-index: 0;\n    pointer-events: none;\n  }\n\n  #win {\n    width: 720px;\n    height: 405px;\n    overflow: hidden;\n    position: relative;\n    z-index: 1;\n    border: 2px solid rgba(200,80,40,0.55);\n    border-bottom: none;\n  }\n\n  #win video {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n\n  /* thin accent line between video and bar */\n  #pip-accent-line {\n    width: 720px;\n    height: 3px;\n    background: linear-gradient(90deg, rgba(220,120,40,0.9) 0%, rgba(255,180,80,1) 40%, rgba(220,120,40,0.9) 100%);\n    z-index: 1;\n    position: relative;\n  }\n\n  #bar {\n    width: 720px;\n    padding: 20px 28px 22px;\n    background: #2a0808;\n    border: 2px solid rgba(200,80,40,0.55);\n    border-top: none;\n    position: relative;\n    z-index: 1;\n  }\n\n  #bar .name {\n    font-family: 'Crimson Pro', Georgia, serif;\n    font-size: 30px;\n    font-weight: 700;\n    color: #f0ece4;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    margin: 0;\n    line-height: 1.2;\n  }\n\n  #bar .src {\n    font-family: 'Crimson Pro', Georgia, serif;\n    font-size: 20px;\n    font-style: italic;\n    font-weight: 300;\n    color: rgba(240,200,170,0.72);\n    margin: 6px 0 0;\n    letter-spacing: 0.07em;\n  }\n\n  /* side label left */\n  #side-label-left {\n    position: absolute;\n    left: 100px;\n    top: 50%;\n    transform: translateY(-50%) rotate(-90deg);\n    transform-origin: center center;\n    font-family: monospace;\n    font-size: 16px;\n    letter-spacing: 0.22em;\n    color: rgba(200,100,50,0.38);\n    text-transform: uppercase;\n    z-index: 5;\n    white-space: nowrap;\n  }\n\n  /* side label right */\n  #side-label-right {\n    position: absolute;\n    right: 100px;\n    top: 50%;\n    transform: translateY(-50%) rotate(90deg);\n    transform-origin: center center;\n    font-family: monospace;\n    font-size: 16px;\n    letter-spacing: 0.22em;\n    color: rgba(200,100,50,0.38);\n    text-transform: uppercase;\n    z-index: 5;\n    white-space: nowrap;\n  }\n</style>\n</head>\n<body>\n\n<div id=\"comp-root\"\n     data-composition-id=\"pip-card-main\"\n     data-start=\"0\"\n     data-duration=\"6\"\n     data-width=\"1920\"\n     data-height=\"1080\"\n     data-track-index=\"0\">\n\n  <!-- Background layers (untimed, always present) -->\n  <div id=\"bg\"></div>\n  <div id=\"ghost-text\">STRANGE</div>\n  <div id=\"vignette\"></div>\n\n  <!-- Decorative frame -->\n  <div id=\"rule-top\"></div>\n  <div id=\"rule-bottom\"></div>\n  <div id=\"reg-tl\"></div>\n  <div id=\"reg-tr\"></div>\n  <div id=\"reg-bl\"></div>\n  <div id=\"reg-br\"></div>\n  <div id=\"meta-label\">Marvel · Feature · 2016</div>\n  <div id=\"meta-right\">PiP / 6s</div>\n  <div id=\"side-label-left\">Doctor Strange · Origin</div>\n  <div id=\"side-label-right\">Marvel Cinematic Universe</div>\n\n  <!-- Main scene clip (single timed parent, children untimed) -->\n  <div id=\"scene-main\"\n       class=\"clip\"\n       data-start=\"0\"\n       data-duration=\"6\"\n       data-track-index=\"1\">\n\n    <!-- PiP card: centered via GSAP translate -->\n    <div id=\"pip-wrap\">\n      <div id=\"pip-glow\"></div>\n      <div id=\"win\">\n        <video id=\"role-video\"\n               src=\"assets/roleVid.mp4\"\n               muted\n               playsinline\n               data-start=\"0\"\n               data-track-index=\"2\">\n        </video>\n      </div>\n      <div id=\"pip-accent-line\"></div>\n      <div id=\"bar\">\n        <p class=\"name\">Doctor Strange</p>\n        <p class=\"src\">Marvel Studios · 2016</p>\n      </div>\n    </div>\n\n  </div><!-- /scene-main -->\n\n</div><!-- /comp-root -->\n\n<script src=\"vendor/gsap.min.js\"></script>\n<script>\n  window.__timelines = window.__timelines || {};\n\n  const tl = gsap.timeline({ paused: true });\n\n  // ── Set initial state for pip-wrap (centered, but starting below + invisible)\n  // pip-wrap is positioned top:50% left:50% — use GSAP to handle both centering and entrance.\n  // We use fromTo so immediateRender writes the correct from-state at construction.\n\n  // Card entrance: RISES from below and settles centered\n  tl.fromTo(\n    \"#pip-wrap\",\n    { x: \"-50%\", y: \"calc(-50% + 40px)\", opacity: 0 },\n    { x: \"-50%\", y: \"-50%\", opacity: 1, duration: 0.85, ease: \"cubic-bezier(0.22,1,0.36,1)\" },\n    0.3\n  );\n\n  // Rules slide in from sides\n  tl.fromTo(\n    \"#rule-top\",\n    { scaleX: 0, transformOrigin: \"50% 50%\" },\n    { scaleX: 1, duration: 0.7, ease: \"power2.out\" },\n    0.1\n  );\n  tl.fromTo(\n    \"#rule-bottom\",\n    { scaleX: 0, transformOrigin: \"50% 50%\" },\n    { scaleX: 1, duration: 0.7, ease: \"power2.out\" },\n    0.2\n  );\n\n  // Registration marks fade in\n  tl.fromTo(\n    [\"#reg-tl\", \"#reg-tr\", \"#reg-bl\", \"#reg-br\"],\n    { opacity: 0 },\n    { opacity: 1, duration: 0.4, stagger: 0.06, ease: \"power1.out\" },\n    0.15\n  );\n\n  // Meta labels fade in\n  tl.fromTo(\n    [\"#meta-label\", \"#meta-right\"],\n    { opacity: 0 },\n    { opacity: 1, duration: 0.5, ease: \"power1.out\" },\n    0.4\n  );\n\n  // Ghost text drifts subtly upward (ambient breathe)\n  tl.fromTo(\n    \"#ghost-text\",\n    { y: 0, opacity: 0.10 },\n    { y: -22, opacity: 0.15, duration: 5.7, ease: \"none\" },\n    0\n  );\n\n  // Accent line draws on\n  tl.fromTo(\n    \"#pip-accent-line\",\n    { scaleX: 0, transformOrigin: \"0% 50%\" },\n    { scaleX: 1, duration: 0.4, ease: \"power2.out\" },\n    0.85\n  );\n\n  // Glow pulses gently (finite: ~2 cycles over breathe phase)\n  tl.fromTo(\n    \"#pip-glow\",\n    { opacity: 0.5 },\n    { opacity: 1, duration: 1.2, ease: \"power1.inOut\", yoyo: true, repeat: 3 },\n    1.0\n  );\n\n  // Side labels fade in staggered\n  tl.fromTo(\n    \"#side-label-left\",\n    { opacity: 0 },\n    { opacity: 1, duration: 0.5, ease: \"power1.out\" },\n    0.7\n  );\n  tl.fromTo(\n    \"#side-label-right\",\n    { opacity: 0 },\n    { opacity: 1, duration: 0.5, ease: \"power1.out\" },\n    0.85\n  );\n\n  // Card exit: fade out at end\n  tl.fromTo(\n    \"#pip-wrap\",\n    { opacity: 1 },\n    { opacity: 0, duration: 0.55, ease: \"power2.in\" },\n    5.15\n  );\n\n  // Fade out decorative